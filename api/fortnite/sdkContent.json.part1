perty\n    FPhysicsControlModifierData DefaultBodyModifierData; // 0xB0 StructProperty\n};\nstatic_assert(sizeof(FPhysicsControlCharacterSetupData) == 0xc0);","Structs/FPhysicsControlControlAndModifierParameters":"// ScriptStruct /Script/PhysicsControl.PhysicsControlControlAndModifierParameters\nstruct FPhysicsControlControlAndModifierParameters\n{\n    TArray<FPhysicsControlNamedControlParameters> ControlParameters; // 0x0 ArrayProperty\n    TArray<FPhysicsControlNamedControlMultiplierParameters> ControlMultiplierParameters; // 0x10 ArrayProperty\n    TArray<FPhysicsControlNamedModifierParameters> ModifierParameters; // 0x20 ArrayProperty\n};\nstatic_assert(sizeof(FPhysicsControlControlAndModifierParameters) == 0x30);","Structs/FPhysicsControlControlAndModifierUpdates":"// ScriptStruct /Script/PhysicsControl.PhysicsControlControlAndModifierUpdates\nstruct FPhysicsControlControlAndModifierUpdates\n{\n    TArray<FPhysicsControlNamedControlParameters> ControlUpdates; // 0x0 ArrayProperty\n    TArray<FPhysicsControlNamedControlMultiplierParameters> ControlMultiplierUpdates; // 0x10 ArrayProperty\n    TArray<FPhysicsControlNamedModifierParameters> ModifierUpdates; // 0x20 ArrayProperty\n};\nstatic_assert(sizeof(FPhysicsControlControlAndModifierUpdates) == 0x30);","Structs/FPhysicsControlCreationData":"// ScriptStruct /Script/PhysicsControl.PhysicsControlCreationData\nstruct FPhysicsControlCreationData\n{\n    FPhysicsControl Control; // 0x0 StructProperty\n    TArray<FName> Sets; // 0xC8 ArrayProperty\n};\nstatic_assert(sizeof(FPhysicsControlCreationData) == 0xd8);","Structs/FPhysicsControlData":"// ScriptStruct /Script/PhysicsControl.PhysicsControlData\nstruct FPhysicsControlData\n{\n    uint8_t Pad_0[4]; // 0x0\n    float LinearStrength; // 0x4 FloatProperty\n    float LinearDampingRatio; // 0x8 FloatProperty\n    float LinearExtraDamping; // 0xC FloatProperty\n    float MaxForce; // 0x10 FloatProperty\n    float AngularStrength; // 0x14 FloatProperty\n    float Angul