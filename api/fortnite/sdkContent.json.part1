sizeof(FPhotoCameraFacingData) == 0x40);","Structs/FPhotoMetadata":"// ScriptStruct /Script/PhotoModeRuntime.PhotoMetadata\nstruct FPhotoMetadata\n{\n    FGuid Guid; // 0x0 StructProperty\n    uint8_t orientation; // 0x10 \n    FGameplayTagContainer GameplayTags; // 0x18 StructProperty\n    TArray<FPhoto2DElement> AdditionalElements; // 0x38 ArrayProperty\n};\nstatic_assert(sizeof(FPhotoMetadata) == 0x48);\n\n}","Structs/FPhotoModeData":"// ScriptStruct /Script/FortniteGame.PhotoModeData\nstruct FPhotoModeData\n{\n    FVector Location; // 0x0 StructProperty\n    FRotator Rotation; // 0x18 StructProperty\n    uint8_t bIsValid : 1; // 0x12E mask=0x1\n    uint8_t : 7;\n};\nstatic_assert(sizeof(FPhotoModeData) == 0x38);","Structs/FPhysicalAnimationData":"// ScriptStruct /Script/Engine.PhysicalAnimationData\nstruct FPhysicalAnimationData\n{\n    FName BodyName; // 0x0 NameProperty\n    float OrientationStrength; // 0x8 FloatProperty\n    float AngularVelocityStrength; // 0xC FloatProperty\n    float PositionStrength; // 0x10 FloatProperty\n    float VelocityStrength; // 0x14 FloatProperty\n    float MaxLinearForce; // 0x18 FloatProperty\n    float MaxAngularForce; // 0x1C FloatProperty\n    uint8_t bIsLocalSimulation : 1; // 0x9C mask=0x1\n    uint8_t : 7;\n};\nstatic_assert(sizeof(FPhysicalAnimationData) == 0x20);","Structs/FPhysicalAnimationProfile":"// ScriptStruct /Script/Engine.PhysicalAnimationProfile\nstruct FPhysicalAnimationProfile\n{\n    FName ProfileName; // 0x0 NameProperty\n    FPhysicalAnimationData PhysicalAnimationData; // 0x4 StructProperty\n};\nstatic_assert(sizeof(FPhysicalAnimationProfile) == 0x24);","Structs/FPhysicalMaterialAttributes_X":"// ScriptStruct /Script/DelMarCore.PhysicalMaterialAttributes_X\nstruct FPhysicalMaterialAttributes_X\n{\n    TArray<UDelMarPhysMatAttribute*> Attributes; // 0x0 ArrayProperty\n};\nstatic_assert(sizeof(FPhysicalMaterialAttributes_X) == 0x10);\n\n}","Structs/FPhysicalMaterialChannel":"// ScriptStruct /Script/MeshPa