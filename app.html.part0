                    </div>
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;margin-bottom:20px" id="apex-stats-grid"></div>
                    <div style="margin-bottom:16px"><button onclick="exportApexDump()" style="background:var(--bg3);border:1px solid var(--border);border-radius:4px;color:var(--fg);padding:6px 14px;font-size:12px;font-family:inherit;cursor:pointer;white-space:nowrap">Export Dump</button></div>
