                <div class="dump-controls">
                    <input type="text" id="obj-search" placeholder="Search by name, type, or index..." oninput="objPage=1;filterObjects()">
                    <select id="obj-type" onchange="objPage=1;filterObjects()">
                        <option value="">All Types</option>
                        <option value="Class">Class (24490)</option>
<option value="ScriptStruct">ScriptStruct (21794)</option>
<option value="Enum">Enum (6628)</option>
<option value="BlueprintGeneratedClass">BlueprintGeneratedClass (2284)</option>
<option value="WidgetBlueprintGeneratedClass">WidgetBlueprintGeneratedClass (1133)</option>
<option value="WidgetBlueprintGeneratedClassExtension_StyleClass">WidgetBlueprintGeneratedClassExtension_StyleClass (955)</option>
<option value="UserDefinedStruct">UserDefinedStruct (133)</option>
<option value="UserDefinedEnum">UserDefinedEnum (110)</option>
<option value="AnimBlueprintGeneratedClass">AnimBlueprintGeneratedClass (88)</option>
<option value="UIComponentWidgetBlueprintGeneratedClassExtension">UIComponentWidgetBlueprintGeneratedClassExtension (5)</option>
<option value="ControlRigBlueprintGeneratedClass">ControlRigBlueprintGeneratedClass (1)</option>
<option value="RigVMBlueprintGeneratedClass">RigVMBlueprintGeneratedClass (1)</option>
                    </select>
                    <button onclick="objPage=1;filterObjects()">Reset</button>
                    <button onclick="exportObjects()" style="margin-left:auto">Export Objects</button>
                </div>
                <div id="obj-count" class="sdk-count"></div>
                <div style="overflow-x:auto">
                    <table class="dump-table">
                        <thead><tr><th>Index</th><th>Type</th><th>Name</th></tr></thead>
                        <tbody id="obj-tbody"></tbody>
                    </table>
                </div>
                <div class="pagination" id="obj-pagination"></div>
            </div>

            <!-- SDK -->
            <div class="panel" id="panel-sdk" style="height:calc(100vh - 44px)">
                <div style="display:flex;height:100%;overflow:hidden">
                    <!-- Left: file list -->
                    <div style="width:320px;min-width:320px;border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden">
                        <div class="sdk-tabs" id="sdk-tabs">
                            <div class="sdk-tab active" data-cat="Structs" onclick="switchSDKCat('Structs')">Structs<span class="tab-count" id="sdk-tab-count-Structs"></span></div>
                            <div class="sdk-tab" data-cat="Classes" onclick="switchSDKCat('Classes')">Classes<span class="tab-count" id="sdk-tab-count-Classes"></span></div>
                            <div class="sdk-tab" data-cat="Enums" onclick="switchSDKCat('Enums')">Enums<span class="tab-count" id="sdk-tab-count-Enums"></span></div>
                        </div>
                        <div style="padding:12px;border-bottom:1px solid var(--border)">
                            <input type="text" id="sdk-search" placeholder="Search..." oninput="filterSDK()" style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:4px;color:var(--fg);padding:7px 10px;font-size:12px;font-family:inherit;outline:none">
                        </div>
                        <div id="sdk-count" style="padding:6px 12px;font-size:11px;color:var(--fg2);border-bottom:1px solid var(--border)"></div>
                        <div id="sdk-scroll-container" style="flex:1;overflow-y:auto;position:relative">
                            <div id="sdk-scroll-spacer"></div>
                            <div id="sdk-list" style="position:absolute;top:0;left:0;right:0"></div>
                        </div>
                    </div>
                    <!-- Right: file content -->
                    <div style="flex:1;display:flex;flex-direction:column;overflow:hidden">
                        <div id="sdk-file-header" style="padding:10px 16px;border-bottom:1px solid var(--border);background:var(--bg2);font-size:12px;color:var(--accent);display:flex;align-items:center;gap:8px">
                            <span style="color:var(--fg2)" id="sdk-file-cat">Struct</span> <span id="sdk-file-name">Select an item</span>
                        </div>
                        <div id="sdk-file-content" style="flex:1;overflow:auto;padding:0">
                            <div style="padding:40px;text-align:center;color:var(--fg2);font-size:12px">Click an item on the left to view its content</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- VALORANT OFFSETS -->
