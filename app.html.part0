                    <input type="text" id="offset-search" placeholder="Search offsets..." oninput="filterOffsets()" style="background:var(--bg);border:1px solid var(--border);border-radius:4px;color:var(--fg);padding:7px 10px;font-size:12px;font-family:inherit;outline:none">
