<div class="offset-group">
<div class="offset-ns">GObjects / Decrypt</div>
<div class="offset-entry"><span class="offset-name">ItemSize (uint32_t)</span><span class="offset-val">0x18 <button class="copy-btn" onclick="copyVal(this,'0x18')">copy</button></span></div>
</div>
<div class="offset-group">
<div class="offset-ns">GWorld / Decrypt</div>
