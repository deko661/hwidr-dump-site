            <!-- DECRYPTS -->
            <div class="panel" id="panel-decrypts">
                <div style="margin-bottom:16px;color:var(--fg2);font-size:12px">Decryption routines and keys for Fortnite's encrypted name/object tables.</div>
                <div class="code-block" style="margin-bottom:12px">
<div class="header">Decrypts/FName.hpp</div>
<pre>#include &lt;intrin.h&gt;
#include &lt;cstdint&gt;
#include &lt;string&gt;
#include &lt;vector&gt;

inline std::int32_t fname_decrypt_index(std::uint32_t enc)
{
    if (!enc) return 0;
    std::uint32_t s = _byteswap_ulong(enc - 1);
    if (s == 0x6903C7EBu) return static_cast&lt;std::int32_t&gt;(-1761855468);
    return static_cast&lt;std::int32_t&gt;(s - 0x6903C7EBu);
}

inline std::int32_t fname_decrypt_number(std::uint32_t enc)
{
    if (!enc) return -1;
    std::uint32_t m = enc - 1;
    if (m == 0xA5F795C0u) return 1063913561;
    return static_cast&lt;std::int32_t&gt;(_byteswap_ulong(m) + 0x3F6A085Au);
}

inline std::uint32_t fname_step(std::uint32_t s)
{
    std::uint32_t t = 8013u * s + 4695698u;
    return t ^ (8u * s) ^ (t &gt;&gt; 11);
}

inline void fname_stream_decrypt(char* buf, std::uint32_t count, std::uint32_t key)
{
    std::uint32_t state = key;
    std::uint8_t hash = static_cast&lt;std::uint8_t&gt;(static_cast&lt;std::uint32_t&gt;(-71) * key);
    for (std::uint32_t i = 0; i &lt; count; ++i) {
        std::uint8_t c = static_cast&lt;std::uint8_t&gt;(buf[i]);
        buf[i] = static_cast&lt;char&gt;(static_cast&lt;std::uint8_t&gt;((hash ^ c) + state + 1));
        hash = c;
        state = fname_step(state);
    }
}

inline std::string fname_to_string(std::int32_t index)
{
    std::int32_t decoded = fname_decrypt_index(static_cast&lt;std::uint32_t&gt;(index));
    if (!decoded) return &quot;&quot;;

    std::uintptr_t pool = driver-&gt;module_base + 0x1C889440;
    std::uintptr_t block = driver::km-&gt;read&lt;std::uint64_t&gt;(pool + 0x10 + (static_cast&lt;std::uint32_t&gt;(decoded) &gt;&gt; 16) * 8);
    if (!block) return &quot;&quot;;

    std::uintptr_t entry = block + 2 * static_cast&lt;std::uint16_t&gt;(decoded);
    std::uint16_t header = driver::km-&gt;read&lt;std::uint16_t&gt;(entry);
    std::uint32_t field = (static_cast&lt;std::uint32_t&gt;(header) &gt;&gt; 1) &amp; 0x3FF;

    if (field == 0x30C) {
        std::int32_t base_index = fname_decrypt_index(driver::km-&gt;read&lt;std::uint32_t&gt;(entry + 6));
        std::int32_t number = fname_decrypt_number(driver::km-&gt;read&lt;std::uint32_t&gt;(entry + 2));
        std::string base = fname_to_string(base_index);
        if (base.empty()) return &quot;&quot;;
        return base + &quot;_&quot; + std::to_string(number);
    }

    std::uint32_t length = field ^ 0x30C;
    if (!length) return &quot;&quot;;

    bool wide = (header &amp; 1) != 0;
    std::uint32_t bytes = wide ? 2u * length : length;

    std::vector&lt;char&gt; buf(bytes);
    driver::km-&gt;read(entry + 2, buf.data(), bytes);

    std::uint32_t t = 8013u * length + 4695698u;
    std::uint32_t key = t ^ (8u * length) ^ (t &gt;&gt; 11);
    fname_stream_decrypt(buf.data(), bytes, key);

    if (wide) {
        const std::uint16_t* w = reinterpret_cast&lt;const std::uint16_t*&gt;(buf.data());
        std::string out;
        out.reserve(length);
        for (std::uint32_t i = 0; i &lt; length; ++i) out.push_back(static_cast&lt;char&gt;(w[i]));
        return out;
    }
    return std::string(buf.data(), length);
}

inline std::string fname_from_object(std::uintptr_t object)
{
    if (!object) return &quot;&quot;;
    return fname_to_string(driver::km-&gt;read&lt;std::int32_t&gt;(object + 0x20));
}
</pre>
</div>
<div class="code-block" style="margin-bottom:12px">
<div class="header">Decrypts/GObjects.hpp</div>
<pre>#include &lt;intrin.h&gt;
#include &lt;cstdint&gt;

inline std::uint32_t get_objects_count()
{
    std::uint32_t r9d = driver::km-&gt;read&lt;std::uint32_t&gt;(driver-&gt;module_base + 0x1C966F28);
    r9d = _byteswap_ulong(r9d);
    r9d += 0x7FD025BCu;
    return r9d;
}

inline std::uintptr_t get_object_by_index(std::uint32_t index, std::uint32_t serial)
{
    if (serial == 0) return 0;
    if (static_cast&lt;std::int32_t&gt;(index) &lt; 0) return 0;

    std::uint32_t r9d = get_objects_count();
    if (static_cast&lt;std::int32_t&gt;(index) &gt;= static_cast&lt;std::int32_t&gt;(r9d)) return 0;

    std::uint64_t r9 = static_cast&lt;std::uint16_t&gt;(index);

    std::uint64_t r10 = driver::km-&gt;read&lt;std::uint64_t&gt;(driver-&gt;module_base + 0x1C966F20);
    r10 = _byteswap_uint64(r10);

    std::uint32_t chunk_index = index &gt;&gt; 16;
    r9 = (r9 * 3) &lt;&lt; 3;
    r9 += driver::km-&gt;read&lt;std::uint64_t&gt;(r10 + static_cast&lt;std::uint64_t&gt;(chunk_index) * 8 + 0x3AE65B74);

    if (r9 == 0) return 0;
    if (driver::km-&gt;read&lt;std::uint32_t&gt;(r9 + 0xC) != serial) return 0;

    return static_cast&lt;std::uintptr_t&gt;(r9);
}
</pre>
</div>
<div class="code-block" style="margin-bottom:12px">
<div class="header">Decrypts/GWorld.hpp</div>
<pre>inline uintptr_t DecryptUWorld(uintptr_t module_base)
{
    uint64_t encrypted = ZenixSys::Read&lt;uint64_t&gt;(module_base + 0x1C14D610);
    if (!encrypted) return 0;

    uint64_t v = encrypted ^ 0xC2A8FFULL;
    v = _rotl64(v, 16);
    v ^= 0xF5136F13ULL;

    uintptr_t world = static_cast&lt;uintptr_t&gt;(v * 0x4F207DBE8FB1498DULL);

    if (world &lt; 0x10000 || (world &amp; 0x7) != 0) return 0;

    return world;
}

GEngineFallback read(read(GEngine+0xB70)+0x78)</pre>
