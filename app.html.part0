</pre>
</div>
<div class="code-block" style="margin-bottom:12px">
<div class="header">Decrypts/GNames.hpp</div>
<pre>#pragma once

#include &lt;string&gt;
#include &quot;Common.hpp&quot;

namespace Decrypt::GNames {

constexpr uint32_t PoolRva    = 0x1AF4CDC0;
constexpr uint32_t BlocksOff  = 0x10;
constexpr uint32_t UObjectNameOff = 0x20;

inline uint32_t Bswap32(uint32_t x)
{
    return (x &lt;&lt; 24) | ((x &lt;&lt; 8) &amp; 0x00FF0000u) | ((x &gt;&gt; 8) &amp; 0x0000FF00u) | (x &gt;&gt; 24);
}

inline uint32_t DecodeIndex(uint32_t enc)
{
    if (!enc)
        return 0;
    const uint32_t t = Bswap32((enc - 1u) ^ 0x6F1D17B8u) + 1u;
    return t ? t : 0x47E8E291u;
}

inline uint32_t Seed(uint32_t len)
{
    const uint32_t a = len * 0x2310u + 0x670073u;
    return ((a &gt;&gt; 23) | (len &lt;&lt; 16)) ^ a;
}

inline uint32_t Rol32s(uint32_t x, uint32_t n)
{
    n &amp;= 31;
    return n ? (x &lt;&lt; n) | (x &gt;&gt; (32 - n)) : x;
}

inline void DecryptBytes(const uint8_t* in, uint8_t* out, uint32_t len, uint32_t seed)
{
    uint32_t st = seed;
    auto step = [&amp;](uint32_t i) {
        out[i] = (uint8_t)(in[i] ^ (uint8_t)st ^ 0xB1u);
        const uint32_t a = st * 0x2310u + 0x670073u;
        st = (a &gt;&gt; 23) ^ Rol32s(st, 16) ^ a;
    };
    for (uint32_t i = 0; i &lt; len; i += 2)
        step(i);
    for (uint32_t i = 1; i &lt; len; i += 2)
        step(i);
}

inline std::string GetName(const ReadFn&amp; rd, uint64_t base, uint32_t id, int depth = 0)
{
    if (depth &gt; 8)
        return {};
    const uint64_t chunk = Read&lt;uint64_t&gt;(rd, base + PoolRva + BlocksOff + (uint64_t)(id &gt;&gt; 16) * 8);
    if (!PtrOk(chunk))
        return {};
    const uint64_t entry = chunk + (uint64_t)(id &amp; 0xFFFF) * 2;
    const uint16_t header = Read&lt;uint16_t&gt;(rd, entry);
    const uint32_t len = (header &gt;&gt; 6) ^ 0x117u;
    const bool wide = (header &amp; 1) != 0;
    if (!len) {
        const uint32_t redir = DecodeIndex(Read&lt;uint32_t&gt;(rd, entry + 2));
        if (!redir || redir == id)
            return {};
        return GetName(rd, base, redir, depth + 1);
    }
    if (len &gt; 1024)
        return {};
    const uint32_t bytes = wide ? len * 2 : len;
    uint8_t raw[2048], dec[2048];
    if (!rd(entry + 2, raw, bytes))
        return {};
    DecryptBytes(raw, dec, bytes, Seed(len));
    std::string s;
    if (wide) {
        for (uint32_t i = 0; i + 1 &lt; bytes; i += 2) {
            const uint16_t c = (uint16_t)(dec[i] | (dec[i + 1] &lt;&lt; 8));
            if (!c)
                break;
            s.push_back((c &gt;= 32 &amp;&amp; c &lt; 127) ? (char)c : &#x27;?&#x27;);
        }
    } else {
        for (uint32_t i = 0; i &lt; len; ++i) {
            if (!dec[i])
                break;
            s.push_back((dec[i] &gt;= 32 &amp;&amp; dec[i] &lt; 127) ? (char)dec[i] : &#x27;?&#x27;);
        }
    }
    return s;
}

inline std::string GetObjectName(const ReadFn&amp; rd, uint64_t base, uint64_t object)
{
    const uint32_t enc = Read&lt;uint32_t&gt;(rd, object + UObjectNameOff);
    return GetName(rd, base, DecodeIndex(enc));
}

}
</pre>
</div>
<div class="code-block" style="margin-bottom:12px">
<div class="header">Decrypts/GObjects.hpp</div>
<pre>#pragma once

#include &quot;Common.hpp&quot;

namespace Decrypt::GObjects {

constexpr uint32_t ChunksRva   = 0x1B028040;
constexpr uint32_t NumRva      = 0x1B028054;
constexpr uint32_t ItemSize    = 0x18;
constexpr uint32_t ItemLow     = 0x10;
constexpr uint32_t UObjectIndexOff = 0x0C;

inline uint32_t Bswap32(uint32_t x)
{
    return (x &lt;&lt; 24) | ((x &lt;&lt; 8) &amp; 0x00FF0000u) | ((x &gt;&gt; 8) &amp; 0x0000FF00u) | (x &gt;&gt; 24);
}

inline uint64_t Bswap64(uint64_t x)
{
    return ((uint64_t)Bswap32((uint32_t)x) &lt;&lt; 32) | Bswap32((uint32_t)(x &gt;&gt; 32));
}

inline uint64_t DecodeChunks(uint64_t enc)
{
    return Bswap64(enc ^ 0xAB47766400000000ull);
}

inline int32_t DecodeNum(uint32_t enc)
{
    return (int32_t)Bswap32(enc ^ 0x0AFED017u);
}

inline uint64_t DecodeItem(uint64_t packed, uint32_t enc32)
{
    if (packed &amp; 0x1020000000000000ull)
        return 0;
    const uint32_t low = Bswap32(enc32 ^ 0x6D8533D2u);
    return ((packed &amp; 0x3FFF00000000ull) | low) &lt;&lt; 3;
}

inline uint32_t DecodeObjectIndex(uint32_t enc)
{
    return Bswap32(enc ^ 0xBF7C1ADDu);
}

struct Table {
    uint64_t chunks = 0;
    int32_t num = 0;
};

inline Table Load(const ReadFn&amp; rd, uint64_t base)
{
    Table t;
    t.chunks = DecodeChunks(Read&lt;uint64_t&gt;(rd, base + ChunksRva));
    t.num = DecodeNum(Read&lt;uint32_t&gt;(rd, base + NumRva));
    return t;
}

inline uint64_t GetObject(const ReadFn&amp; rd, const Table&amp; t, int32_t index)
{
    if (index &lt; 0 || index &gt;= t.num || !PtrOk(t.chunks))
        return 0;
    const uint64_t chunk = Read&lt;uint64_t&gt;(rd, t.chunks + (uint64_t)(index &gt;&gt; 16) * 8);
    if (!PtrOk(chunk))
        return 0;
    const uint64_t item = chunk + (uint64_t)(index &amp; 0xFFFF) * ItemSize;
    const uint64_t packed = Read&lt;uint64_t&gt;(rd, item);
    const uint32_t enc32 = Read&lt;uint32_t&gt;(rd, item + ItemLow);
    const uint64_t obj = DecodeItem(packed, enc32);
    if (!PtrOk(obj))
        return 0;
    if (DecodeObjectIndex(Read&lt;uint32_t&gt;(rd, obj + UObjectIndexOff)) != (uint32_t)index)
        return 0;
    return obj;
}

}
</pre>
</div>
<div class="code-block" style="margin-bottom:12px">
<div class="header">Decrypts/GWorld.hpp</div>
<pre>#pragma once

#include &quot;Common.hpp&quot;

namespace Decrypt::GWorld {

constexpr uint32_t Rva = 0x1B096DE8;
constexpr uint32_t GetWorldVftIndexOff = 0x160;

inline uint64_t Bswap64(uint64_t x)
{
    const uint32_t lo = (uint32_t)x;
    const uint32_t hi = (uint32_t)(x &gt;&gt; 32);
    const uint32_t slo = (lo &lt;&lt; 24) | ((lo &lt;&lt; 8) &amp; 0x00FF0000u) | ((lo &gt;&gt; 8) &amp; 0x0000FF00u) | (lo &gt;&gt; 24);
    const uint32_t shi = (hi &lt;&lt; 24) | ((hi &lt;&lt; 8) &amp; 0x00FF0000u) | ((hi &gt;&gt; 8) &amp; 0x0000FF00u) | (hi &gt;&gt; 24);
    return ((uint64_t)slo &lt;&lt; 32) | shi;
}

inline uint64_t Decode(uint64_t enc)
{
    return Bswap64(enc ^ 0xAFB5C90D00000000ull);
}

inline uint64_t Get(const ReadFn&amp; rd, uint64_t base)
{
    const uint64_t w = Decode(Read&lt;uint64_t&gt;(rd, base + Rva));
    return PtrOk(w) ? w : 0;
}

}
</pre>
