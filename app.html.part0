<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HWIDR SDK Viewer</title>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<style>
*{margin:0;padding:0;box-sizing:border-box}
.captcha-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:var(--bg);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;transition:opacity .4s}
.captcha-overlay.hidden{opacity:0;pointer-events:none}
.captcha-title{font-size:18px;font-weight:700;color:var(--accent);letter-spacing:1px;text-transform:uppercase}
.captcha-sub{font-size:12px;color:var(--fg2)}
:root{
--bg:#0a0a0a;--bg2:#111;--bg3:#1a1a1a;--bg4:#222;
--fg:#e0e0e0;--fg2:#999;--accent:#fff;--accent2:#ccc;
--border:#2a2a2a;--border2:#333;--code-bg:#0d0d0d;
--hover:#1f1f1f;--select:#2a2a2a;
}
html,body{height:100%;background:var(--bg);color:var(--fg);font-family:Consolas,Monaco,'Courier New',monospace;font-size:13px}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:#333;border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:#555}
.layout{display:flex;height:100vh;overflow:hidden}

/* SIDEBAR */
.sidebar{width:240px;min-width:240px;background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden}
.sidebar-header{padding:16px 16px 12px;border-bottom:1px solid var(--border)}
.sidebar-header h1{font-size:14px;font-weight:600;color:var(--accent);letter-spacing:1px;text-transform:uppercase;margin-bottom:4px}
.sidebar-header .subtitle{font-size:11px;color:var(--fg2)}
.nav{flex:1;overflow-y:auto;padding:8px 0}
.nav-item{padding:8px 16px;cursor:pointer;color:var(--fg2);font-size:12px;display:flex;align-items:center;gap:8px;transition:all .1s}
.nav-item:hover{background:var(--hover);color:var(--fg)}
.nav-item.active{background:var(--select);color:var(--accent);border-left:2px solid var(--accent)}
.nav-item .icon{width:16px;text-align:center;font-size:10px;color:var(--fg2)}
.nav-section{padding:12px 16px 4px;font-size:10px;color:var(--fg2);text-transform:uppercase;letter-spacing:1px}

/* MAIN */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden}
.topbar{padding:10px 20px;border-bottom:1px solid var(--border);background:var(--bg2);display:flex;align-items:center;gap:12px;min-height:44px}
.topbar .breadcrumb{font-size:12px;color:var(--fg2)}
.topbar .breadcrumb span{color:var(--accent)}
.content{flex:1;overflow-y:auto;padding:20px}

/* STATS */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:24px}
.stat-card{background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:16px;transition:border-color .2s}
.stat-card:hover{border-color:var(--border2)}
.stat-card .label{font-size:10px;color:var(--fg2);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px}
.stat-card .value{font-size:22px;color:var(--accent);font-weight:600}
.stat-card .detail{font-size:11px;color:var(--fg2);margin-top:4px}

/* OFFSETS */
.offset-group{margin-bottom:16px;background:var(--bg2);border:1px solid var(--border);border-radius:6px;overflow:hidden}
.offset-ns{padding:8px 14px;font-size:11px;font-weight:600;color:var(--accent);background:var(--bg3);border-bottom:1px solid var(--border);text-transform:uppercase;letter-spacing:.5px}
.offset-entry{display:flex;justify-content:space-between;align-items:center;padding:6px 14px;border-bottom:1px solid var(--border);font-size:12px}
.offset-entry:last-child{border-bottom:none}
.offset-entry:hover{background:var(--hover)}
.offset-name{color:var(--fg)}
.offset-val{color:var(--accent2);font-weight:500;display:flex;align-items:center;gap:6px}
.copy-btn{background:var(--bg);border:1px solid var(--border);border-radius:3px;color:var(--fg2);padding:2px 6px;font-size:9px;font-family:inherit;cursor:pointer;opacity:0;transition:opacity .15s}
.offset-entry:hover .copy-btn{opacity:1}
.copy-btn:hover{background:var(--bg4);color:var(--fg)}
.copy-btn.copied{color:var(--accent);border-color:var(--accent2);opacity:1}

/* CODE */
.code-block{background:var(--code-bg);border:1px solid var(--border);border-radius:6px;overflow:hidden}
.code-block pre{padding:16px;overflow-x:auto;font-size:12px;line-height:1.6;color:var(--fg);white-space:pre}
.code-block .header{padding:8px 14px;background:var(--bg3);border-bottom:1px solid var(--border);font-size:11px;color:var(--fg2)}

/* DUMPS */
.dump-controls{display:flex;gap:8px;margin-bottom:12px;align-items:center;flex-wrap:wrap}
.dump-controls input,.dump-controls select{background:var(--bg2);border:1px solid var(--border);border-radius:4px;color:var(--fg);padding:6px 10px;font-size:12px;font-family:inherit;outline:none}
.dump-controls input{flex:1;min-width:200px}
.dump-controls select{min-width:140px}
.dump-controls button{background:var(--bg3);border:1px solid var(--border);border-radius:4px;color:var(--fg);padding:6px 12px;font-size:12px;font-family:inherit;cursor:pointer}
.dump-controls button:hover{background:var(--bg4)}
.dump-table{width:100%;border-collapse:collapse}
.dump-table th{text-align:left;padding:8px 12px;font-size:10px;color:var(--fg2);text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid var(--border);background:var(--bg2);position:sticky;top:0;z-index:1}
.dump-table td{padding:5px 12px;border-bottom:1px solid var(--border);font-size:12px}
.dump-table tr:hover{background:var(--hover)}
.dump-table .idx{color:var(--fg2);min-width:60px}
.dump-table .addr{color:#6a9fb5;min-width:120px}
.dump-table .type{color:#b294bb;min-width:80px}
.dump-table .name{color:var(--fg)}
.dump-table .flags{color:#6a9fb5}
.pagination{display:flex;gap:4px;margin-top:12px;align-items:center;justify-content:center;flex-wrap:wrap}
.pagination button{background:var(--bg2);border:1px solid var(--border);border-radius:3px;color:var(--fg2);padding:4px 10px;font-size:11px;font-family:inherit;cursor:pointer}
.pagination button:hover{background:var(--bg4);color:var(--fg)}
.pagination button.active{background:var(--select);color:var(--accent);border-color:var(--accent2)}
.pagination .info{color:var(--fg2);font-size:11px;padding:0 8px}

/* LETTER INDEX */
.letter-index{display:flex;gap:3px;margin-bottom:12px;flex-wrap:wrap}
.letter-index button{background:var(--bg2);border:1px solid var(--border);border-radius:3px;color:var(--fg2);padding:4px 8px;font-size:11px;font-family:inherit;cursor:pointer;min-width:28px;text-align:center}
.letter-index button:hover{background:var(--bg4);color:var(--fg)}
.letter-index button.active{background:var(--select);color:var(--accent);border-color:var(--accent2)}

/* SDK */
.sdk-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:8px}
.sdk-item{background:var(--bg2);border:1px solid var(--border);border-radius:4px;padding:8px 12px;font-size:12px;cursor:default;transition:border-color .1s;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sdk-item:hover{border-color:var(--accent2);background:var(--hover)}
.sdk-file-item{height:32px;line-height:32px;padding:0 12px;font-size:12px;color:var(--fg2);cursor:pointer;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;transition:background .05s}
.sdk-file-item:hover{background:var(--hover);color:var(--fg)}
.sdk-file-item.selected{background:var(--select);color:var(--accent)}
.sdk-count{font-size:11px;color:var(--fg2);margin-bottom:12px}
.sdk-tabs{display:flex;gap:2px;padding:6px 12px;border-bottom:1px solid var(--border);background:var(--bg2)}
.sdk-tab{padding:5px 12px;font-size:11px;border-radius:4px;cursor:pointer;color:var(--fg2);transition:background .1s,color .1s;user-select:none}
.sdk-tab:hover{background:var(--hover);color:var(--fg)}
.sdk-tab.active{background:var(--select);color:var(--accent);font-weight:600}
.sdk-tab .tab-count{margin-left:4px;opacity:.6;font-weight:400}
.sdk-hl-kw{color:#c586c0}.sdk-hl-type{color:#4ec9b0}.sdk-hl-str{color:#ce9178}.sdk-hl-num{color:#b5cea8}.sdk-hl-cmt{color:#6a9955;font-style:italic}.sdk-hl-pre{color:#c586c0}.sdk-hl-off{color:#808080}
.game-selector{display:flex;gap:4px;margin-bottom:16px}
.game-btn{padding:6px 16px;font-size:12px;border-radius:4px;cursor:pointer;color:var(--fg2);background:var(--bg2);border:1px solid var(--border);transition:all .1s;font-family:inherit}
.game-btn:hover{background:var(--hover);color:var(--fg)}
.game-btn.active{background:var(--select);color:var(--accent);border-color:var(--accent2);font-weight:600}
.status-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:middle;transition:background .3s}
.status-dot.green{background:#4caf50;box-shadow:0 0 6px #4caf50}
.status-dot.red{background:#f44336;box-shadow:0 0 6px #f44336}
.status-dot.pending{background:#ff9800;box-shadow:0 0 6px #ff9800}
.game-btn .ver{font-size:10px;opacity:.6;margin-left:4px;font-weight:400}
.nav-game{display:none}
.nav-game.active{display:block}

/* API DOCS */
.docs-header-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px}
.docs-header-row .game-selector{margin-bottom:0}
.docs-header-row .spacer{flex:1}
.docs-btn{padding:6px 16px;font-size:12px;border-radius:4px;cursor:pointer;color:var(--fg2);background:var(--bg2);border:1px solid var(--border);transition:all .1s;font-family:inherit;display:flex;align-items:center;gap:6px}
.docs-btn:hover{background:var(--hover);color:var(--accent);border-color:var(--accent2)}
.docs-endpoint{background:var(--bg2);border:1px solid var(--border);border-radius:6px;margin-bottom:8px;overflow:hidden}
.docs-endpoint-head{display:flex;align-items:center;gap:10px;padding:10px 14px;cursor:pointer;transition:background .1s}
.docs-endpoint-head:hover{background:var(--hover)}
.docs-method{background:var(--bg3);border:1px solid var(--border2);border-radius:3px;color:#4caf50;padding:2px 8px;font-size:10px;font-weight:600;letter-spacing:1px}
.docs-path{color:var(--accent);font-size:12px}
.docs-desc{color:var(--fg2);font-size:11px;flex:1;text-align:right}
.docs-arrow{color:var(--fg2);font-size:10px;transition:transform .15s}
.docs-endpoint.open .docs-arrow{transform:rotate(90deg)}
.docs-endpoint-body{display:none;padding:14px;border-top:1px solid var(--border);background:var(--code-bg)}
.docs-endpoint.open .docs-endpoint-body{display:block}
.docs-curl{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.docs-curl pre{flex:1;background:var(--bg);border:1px solid var(--border);border-radius:4px;padding:8px 12px;font-size:11px;color:#6a9fb5;overflow-x:auto;white-space:pre;margin:0}
.docs-try{display:flex;gap:8px;margin-top:10px;align-items:center}
.docs-try button{background:var(--bg3);border:1px solid var(--border);border-radius:4px;color:var(--fg);padding:6px 12px;font-size:11px;font-family:inherit;cursor:pointer;white-space:nowrap}
.docs-try button:hover{background:var(--bg4);color:var(--accent)}
.docs-try-result{margin-top:8px;max-height:240px;overflow:auto;background:var(--bg);border:1px solid var(--border);border-radius:4px;padding:10px 12px;font-size:11px;color:#b5cea8;white-space:pre;word-break:break-all;display:none}
.docs-note{background:var(--bg2);border:1px solid var(--border);border-left:3px solid var(--accent2);border-radius:6px;padding:12px 16px;margin-bottom:16px;font-size:12px;color:var(--fg2);line-height:1.7}
.docs-note code{color:var(--accent);background:var(--bg3);padding:1px 5px;border-radius:3px;font-size:11px}

.layout{position:relative;z-index:1}

/* BUILDBAR */
.build-bar{display:flex;align-items:center;margin-bottom:20px;background:var(--bg2);border:1px solid var(--border);border-radius:6px;overflow:hidden;font-size:11px}
.build-item{flex:1;display:flex;align-items:center;gap:8px;padding:8px 16px;color:var(--fg2);border-right:1px solid var(--border)}
.build-item:last-child{border-right:none}
.build-item .label{color:var(--fg2);text-transform:uppercase;letter-spacing:.5px;font-size:10px;white-space:nowrap}
.build-item .val{color:var(--accent);font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.build-icon{color:var(--accent2);font-size:11px;flex-shrink:0}

/* PANELS */
.panel{display:none}
.panel.active{display:block}
#panel-sdk.active{display:flex}
</style>
</head>
<body>
<div class="captcha-overlay" id="captcha-overlay">
    <div class="captcha-title">HWIDR SDK Viewer</div>
    <div class="captcha-sub">Checking...</div>
    <div class="cf-turnstile" data-sitekey="0x4AAAAAAEct7SWC6yI9-pD8" data-callback="onCaptchaSuccess" data-theme="dark"></div>
</div>
<div class="layout">
    <div class="sidebar">
        <div class="sidebar-header">
            <h1>HWIDR SDK</h1>
            <div class="subtitle" id="sidebar-subtitle">Fortnite Dumper Viewer</div>
        </div>
        <div class="nav">
            <div class="nav-section">General</div>
            <div class="nav-item active" data-section="overview" onclick="showSection('overview')">
                <span class="icon"></span> Overview
            </div>
            <div class="nav-item" data-section="docs" onclick="showSection('docs')">
                <span class="icon"></span> API Docs
            </div>
            <div class="nav-game active" data-game="fortnite">
                <div class="nav-section">Fortnite</div>
                <div class="nav-item" data-section="offsets" onclick="showSection('offsets')">
                    <span class="icon"></span> Offsets
                </div>
                <div class="nav-item" data-section="decrypts" onclick="showSection('decrypts')">
                    <span class="icon"></span> Decrypts
                </div>
                <div class="nav-section">Dumps</div>
                <div class="nav-item" data-section="names" onclick="showSection('names')">
                    <span class="icon"></span> Names (56,579)
                </div>
                <div class="nav-item" data-section="functions" onclick="showSection('functions')">
                    <span class="icon"></span> Functions (76,573)
                </div>
                <div class="nav-item" data-section="objects" onclick="showSection('objects')">
                    <span class="icon"></span> Objects (56,579)
                </div>
                <div class="nav-section">SDK</div>
                <div class="nav-item" data-section="sdk" onclick="showSection('sdk')">
                    <span class="icon">&gt;</span> SDK (52,102)
                </div>
            </div>
            <div class="nav-game" data-game="apex">
                <div class="nav-section">Apex Legends</div>
                <div class="nav-item" data-section="apex-mics" onclick="showSection('apex-mics')">
                    <span class="icon"></span> Global Pointers
                </div>
                <div class="nav-item" data-section="apex-buttons" onclick="showSection('apex-buttons')">
                    <span class="icon"></span> Buttons
                </div>
                <div class="nav-item" data-section="apex-recvtables" onclick="showSection('apex-recvtables')">
                    <span class="icon"></span> RecvTables
                </div>
            </div>
            <div class="nav-game" data-game="valorant">
                <div class="nav-section">Valorant</div>
                <div class="nav-item" data-section="valorant-offsets" onclick="showSection('valorant-offsets')">
                    <span class="icon"></span> Offsets
                </div>
                <div class="nav-item" data-section="valorant-decrypts" onclick="showSection('valorant-decrypts')">
                    <span class="icon"></span> Decrypts
                </div>
                <div class="nav-section">Dumps</div>
                <div class="nav-item" data-section="valorant-names" onclick="showSection('valorant-names')">
                    <span class="icon"></span> Names (41,621)
                </div>
                <div class="nav-item" data-section="valorant-functions" onclick="showSection('valorant-functions')">
                    <span class="icon"></span> Functions (35,012)
                </div>
                <div class="nav-item" data-section="valorant-objects" onclick="showSection('valorant-objects')">
                    <span class="icon"></span> Objects (41,621)
                </div>
                <div class="nav-section">SDK</div>
                <div class="nav-item" data-section="valorant-sdk" onclick="showSection('valorant-sdk')">
                    <span class="icon">&gt;</span> SDK (18,563)
                </div>
            </div>
        </div>
    </div>
    <div class="main">
        <div class="topbar">
            <div class="breadcrumb" id="breadcrumb"><span>Overview</span></div>
        </div>
        <div class="content" id="content">

            <!-- OVERVIEW -->
            <div class="panel active" id="panel-overview">
                <div class="docs-header-row">
                    <div class="game-selector">
                        <div class="game-btn active" onclick="switchGame('fortnite')"><span class="status-dot pending" id="dot-fortnite"></span>Fortnite<span class="ver" id="ver-fortnite"></span></div>
                        <div class="game-btn" onclick="switchGame('apex')"><span class="status-dot pending" id="dot-apex"></span>Apex Legends<span class="ver" id="ver-apex"></span></div>
                        <div class="game-btn" onclick="switchGame('valorant')"><span class="status-dot pending" id="dot-valorant"></span>Valorant<span class="ver" id="ver-valorant"></span></div>
                    </div>
                    <div class="spacer"></div>
                    <button class="docs-btn" onclick="showSection('docs')" title="API Documentation">Docs</button>
                </div>
                <div id="overview-fortnite">
                    <div style="display:flex;align-items:center;gap:24px;margin-bottom:24px;background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:24px">
                    <div style="flex:1">
                        <div style="font-size:18px;color:var(--accent);font-weight:600;margin-bottom:10px">Hey, it’s 0x661. </div>
                        <div style="font-size:14px;color:var(--fg);line-height:1.7;margin-bottom:10px">I’m way too tired to keep dumping the game myself, so shoutout to Bear for dumping the game after every update. I repost his dumps on this site to make them easier to browse and read.</div>
                        <div style="font-size:14px;color:var(--fg);line-height:1.7;margin-bottom:14px">Join the Discord: <a href="https://discord.gg/YZJgRkEyVH" target="_blank" style="color:var(--accent2);text-decoration:underline">discord.gg/YZJgRkEyVH</a></div>
                        <div style="font-size:13px;color:var(--fg2)">Enjoy the viewer.</div>
                    </div>
                    <div style="flex-shrink:0"><img src="https://files.catbox.moe/oa8lzh.png" style="height:300px;border-radius:6px;border:1px solid var(--border)"></div>
                </div>
                <div class="build-bar" id="build-bar">
                    <div class="build-item"><span class="build-icon">&#9660;</span><span class="label">Build</span><span class="val" id="build-hash">Loading...</span></div>
                    <div class="build-item"><span class="build-icon">&#9733;</span><span class="label">Target</span><span class="val" id="build-target">-</span></div>
                    <div class="build-item"><span class="build-icon">&#9776;</span><span class="label">Size</span><span class="val" id="build-size">-</span></div>
                    <div class="build-item"><span class="build-icon">&#9650;</span><span class="label">Released</span><span class="val" id="build-date">-</span></div>
                </div>
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="label">Names (GNames)</div>
                        <div class="value">56,579</div>
                        <div class="detail">Name entries in pool</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Objects (GObjects)</div>
                        <div class="value">56,579</div>
                        <div class="detail">UObject entries</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Functions</div>
                        <div class="value">76,573</div>
                        <div class="detail">UFunction entries</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Classes</div>
                        <div class="value">9,195</div>
                        <div class="detail">Unique class definitions</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">SDK Types</div>
                        <div class="value">52,102</div>
                        <div class="detail">Generated header files</div>
                    </div>
                    <div class="stat-card">
                        <div class="label">Object Types</div>
                        <div class="value">12</div>
                        <div class="detail">Unique object categories</div>
                    </div>
                </div>
                </div>
                <div id="overview-apex" style="display:none">
                    <div style="display:flex;align-items:center;gap:24px;margin-bottom:24px;background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:24px">
                    <div style="flex:1">
                        <div style="font-size:18px;color:var(--accent);font-weight:600;margin-bottom:10px">Hey, it’s 0x661.</div>
                        <div style="font-size:14px;color:var(--fg);line-height:1.7;margin-bottom:10px">Sometimes I dump Apex myself, and sometimes I just repost dumps I find on UnknownCheats and other forums.</div>
                        <div style="font-size:14px;color:var(--fg);line-height:1.7;margin-bottom:14px">Join the Discord: <a href="https://discord.gg/YZJgRkEyVH" target="_blank" style="color:var(--accent2);text-decoration:underline">discord.gg/YZJgRkEyVH</a></div>
                        <div style="font-size:13px;color:var(--fg2)">Enjoy the viewer.</div>
                    </div>
                    <div style="flex-shrink:0"><img src="https://files.catbox.moe/oa8lzh.png" style="height:300px;border-radius:6px;border:1px solid var(--border)"></div>
                    </div>
                    <div class="build-bar" id="build-bar-apex">
                        <div class="build-item"><span class="build-icon">&#9660;</span><span class="label">Build</span><span class="val" id="build-hash-apex">Loading...</span></div>
                        <div class="build-item"><span class="build-icon">&#9733;</span><span class="label">Target</span><span class="val" id="build-target-apex">r5apex_dx12.exe</span></div>
                        <div class="build-item"><span class="build-icon">&#9776;</span><span class="label">Size</span><span class="val" id="build-size-apex">-</span></div>
