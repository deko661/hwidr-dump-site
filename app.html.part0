            <!-- VALORANT NAMES -->
            <div class="panel" id="panel-valorant-names">
                <div class="dump-controls">
                    <input type="text" id="valorant-name-search" placeholder="Search names..." oninput="valorantNamePage=1;filterValorantNames()">
                    <button onclick="valorantNamePage=1;filterValorantNames()">Reset</button>
                    <button onclick="exportValorantNames()" style="margin-left:auto">Export Names</button>
                </div>
                <div id="valorant-name-count" class="sdk-count"></div>
                <div style="overflow-x:auto">
                    <table class="dump-table">
                        <thead><tr><th>Index</th><th>Name</th></tr></thead>
                        <tbody id="valorant-name-tbody"></tbody>
                    </table>
                </div>
                <div class="pagination" id="valorant-name-pagination"></div>
            </div>

            <!-- VALORANT FUNCTIONS -->
            <div class="panel" id="panel-valorant-functions">
                <div class="dump-controls">
                    <input type="text" id="valorant-func-search" placeholder="Search classes or functions..." oninput="valorantFuncPage=1;filterValorantFunctions()">
                    <button onclick="valorantFuncPage=1;filterValorantFunctions()">Reset</button>
                    <button onclick="exportValorantFunctions()" style="margin-left:auto">Export Functions</button>
                </div>
                <div id="valorant-func-count" class="sdk-count"></div>
                <div class="letter-index" id="valorant-func-letters"></div>
                <div id="valorant-func-list"></div>
                <div class="pagination" id="valorant-func-pagination"></div>
            </div>

            <!-- VALORANT OBJECTS -->
            <div class="panel" id="panel-valorant-objects">
                <div class="dump-controls">
                    <input type="text" id="valorant-obj-search" placeholder="Search by name, type, or index..." oninput="valorantObjPage=1;filterValorantObjects()">
                    <select id="valorant-obj-type" onchange="valorantObjPage=1;filterValorantObjects()">
                        <option value="">All Types</option>
                        <option value="BlueprintGeneratedClass">BlueprintGeneratedClass (20792)</option>
<option value="Class">Class (8881)</option>
<option value="ScriptStruct">ScriptStruct (7444)</option>
<option value="Enum">Enum (2793)</option>
<option value="WidgetBlueprintGeneratedClass">WidgetBlueprintGeneratedClass (2051)</option>
<option value="UserDefinedEnum">UserDefinedEnum (152)</option>
<option value="UserDefinedStruct">UserDefinedStruct (120)</option>
<option value="AnimBlueprintGeneratedClass">AnimBlueprintGeneratedClass (16)</option>
                    </select>
                    <button onclick="valorantObjPage=1;filterValorantObjects()">Reset</button>
                    <button onclick="exportValorantObjects()" style="margin-left:auto">Export Objects</button>
                </div>
                <div id="valorant-obj-count" class="sdk-count"></div>
                <div style="overflow-x:auto">
                    <table class="dump-table">
                        <thead><tr><th>Index</th><th>Type</th><th>Name</th></tr></thead>
                        <tbody id="valorant-obj-tbody"></tbody>
                    </table>
                </div>
                <div class="pagination" id="valorant-obj-pagination"></div>
            </div>

            <!-- VALORANT SDK -->
            <div class="panel" id="panel-valorant-sdk" style="height:calc(100vh - 44px)">
                <div style="display:flex;height:100%;overflow:hidden">
                    <div style="width:320px;min-width:320px;border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden">
                        <div class="sdk-tabs" id="valorant-sdk-tabs">
                            <div class="sdk-tab active" data-cat="Structs" onclick="switchValorantSDKCat('Structs')">Structs<span class="tab-count" id="valorant-sdk-tab-count-Structs"></span></div>
                            <div class="sdk-tab" data-cat="Classes" onclick="switchValorantSDKCat('Classes')">Classes<span class="tab-count" id="valorant-sdk-tab-count-Classes"></span></div>
                            <div class="sdk-tab" data-cat="Enums" onclick="switchValorantSDKCat('Enums')">Enums<span class="tab-count" id="valorant-sdk-tab-count-Enums"></span></div>
                        </div>
                        <div style="padding:12px;border-bottom:1px solid var(--border)">
                            <input type="text" id="valorant-sdk-search" placeholder="Search..." oninput="filterValorantSDK()" style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:4px;color:var(--fg);padding:7px 10px;font-size:12px;font-family:inherit;outline:none">
                        </div>
                        <div id="valorant-sdk-count" style="padding:6px 12px;font-size:11px;color:var(--fg2);border-bottom:1px solid var(--border)"></div>
                        <div id="valorant-sdk-scroll-container" style="flex:1;overflow-y:auto;position:relative">
                            <div id="valorant-sdk-scroll-spacer"></div>
                            <div id="valorant-sdk-list" style="position:absolute;top:0;left:0;right:0"></div>
                        </div>
                    </div>
                    <div style="flex:1;display:flex;flex-direction:column;overflow:hidden">
                        <div id="valorant-sdk-file-header" style="padding:10px 16px;border-bottom:1px solid var(--border);background:var(--bg2);font-size:12px;color:var(--accent);display:flex;align-items:center;gap:8px">
                            <span style="color:var(--fg2)" id="valorant-sdk-file-cat">Struct</span> <span id="valorant-sdk-file-name">Select an item</span>
                        </div>
                        <div id="valorant-sdk-file-content" style="flex:1;overflow:auto;padding:0">
                            <div style="padding:40px;text-align:center;color:var(--fg2);font-size:12px">Click an item on the left to view its content</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- APEX MICS -->
            <div class="panel" id="panel-apex-mics">
                <div style="color:var(--fg2);font-size:12px;margin-bottom:16px">Global pointer offsets for r5apex_dx12.exe</div>
                <table class="dump-table">
                    <thead><tr><th>Name</th><th>Offset</th><th></th></tr></thead>
                    <tbody id="apex-mics-tbody"></tbody>
                </table>
            </div>

            <!-- APEX BUTTONS -->
            <div class="panel" id="panel-apex-buttons">
                <div style="color:var(--fg2);font-size:12px;margin-bottom:16px">Input button command buffer offsets</div>
                <table class="dump-table">
                    <thead><tr><th>Button</th><th>Offset</th><th></th></tr></thead>
                    <tbody id="apex-buttons-tbody"></tbody>
                </table>
            </div>

            <!-- APEX RECVTABLES -->
            <div class="panel" id="panel-apex-recvtables" style="height:calc(100vh - 44px)">
                <div style="display:flex;height:100%;overflow:hidden">
                    <div style="width:320px;min-width:320px;border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden">
                        <div style="padding:12px;border-bottom:1px solid var(--border)">
                            <input type="text" id="apex-rt-search" placeholder="Search tables..." oninput="filterApexRT()" style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:4px;color:var(--fg);padding:7px 10px;font-size:12px;font-family:inherit;outline:none">
                        </div>
                        <div id="apex-rt-count" style="padding:6px 12px;font-size:11px;color:var(--fg2);border-bottom:1px solid var(--border)"></div>
                        <div id="apex-rt-scroll-container" style="flex:1;overflow-y:auto;position:relative">
                            <div id="apex-rt-scroll-spacer"></div>
                            <div id="apex-rt-list" style="position:absolute;top:0;left:0;right:0"></div>
                        </div>
                    </div>
                    <div style="flex:1;display:flex;flex-direction:column;overflow:hidden">
                        <div style="padding:10px 16px;border-bottom:1px solid var(--border);background:var(--bg2);font-size:12px;color:var(--accent);display:flex;align-items:center;gap:8px">
                            <span style="color:var(--fg2)">table</span> <span id="apex-rt-name">Select a table</span>
                        </div>
                        <div id="apex-rt-content" style="flex:1;overflow:auto;padding:0">
                            <div style="padding:40px;text-align:center;color:var(--fg2);font-size:12px">Click a table on the left to view its fields</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- APEX DUMP TXT -->
            <div class="panel" id="panel-apex-dump" style="height:calc(100vh - 44px);overflow:hidden;padding:0;border-top:1px solid var(--border);box-sizing:border-box">
                <div style="display:flex;align-items:center;gap:8px;padding:10px 16px;border-bottom:1px solid var(--border);background:var(--bg2);flex-shrink:0">
                    <div style="color:var(--fg2);font-size:12px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Apex dump entier (r5apex_dx12.exe.txt)</div>
                    <button onclick="exportApexDump()" style="background:var(--bg3);border:1px solid var(--border);border-radius:4px;color:var(--fg);padding:6px 12px;font-size:12px;font-family:inherit;cursor:pointer;white-space:nowrap">Export Dump</button>
                    <button onclick="copyApexDump()" style="background:var(--bg3);border:1px solid var(--border);border-radius:4px;color:var(--fg);padding:6px 12px;font-size:12px;font-family:inherit;cursor:pointer;white-space:nowrap">Copy All</button>
                </div>
                <pre id="apex-dump-text" style="padding:12px 16px;font-size:11px;line-height:1.4;color:var(--fg);white-space:pre-wrap;overflow-wrap:anywhere;width:100%;max-width:100%;box-sizing:border-box;overflow-x:hidden;">[Mics] 
