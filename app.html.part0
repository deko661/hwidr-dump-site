<div class="code-block" style="margin-bottom:12px">
<div class="header">Decrypts/GNames.hpp</div>
<pre>#pragma once

#include &lt;string&gt;
#include &quot;../Offsets.hpp&quot;
#include &quot;State.hpp&quot;

namespace Decrypt::GNames {

inline std::string GetName(const ReadFn&amp; rd, uint64_t base, uint32_t id, uint32_t xorKey, int depth = 0);

inline uint32_t RecoverPoolKey(const ReadFn&amp; rd, uint64_t base)
{
    const uint64_t chunk = Read&lt;uint64_t&gt;(rd, base + Offsets::GNames + Offsets::NamePoolBlocks);
    if (!PtrOk(chunk))
        return 0;
    const uint16_t header = Read&lt;uint16_t&gt;(rd, chunk + 4);
    const uint32_t len = header &gt;&gt; 1;
    if (len != 4 || (header &amp; 1))
        return 0;
    uint8_t n0[4]{};
    if (!rd(chunk + 6, n0, 4))
        return 0;
    uint32_t key = 0;
    uint8_t* kb = reinterpret_cast&lt;uint8_t*&gt;(&amp;key);
    const char none[] = { &#x27;N&#x27;, &#x27;o&#x27;, &#x27;n&#x27;, &#x27;e&#x27; };
    for (int j = 0; j &lt; 4; ++j)
        kb[j] = (uint8_t)(n0[j] ^ (uint8_t)(len &amp; 0xFF) ^ (uint8_t)none[j]);
    if (GetName(rd, base, 0, key) != &quot;None&quot;)
        return 0;
    return key;
}

inline uint32_t PoolKey(const ReadFn&amp; rd, uint64_t base)
{
    uint64_t state[7]{};
    const uint32_t seed = Read&lt;uint32_t&gt;(rd, base + Offsets::FNameKey);
    if (seed &amp;&amp; rd(base + Offsets::FNameState, state, sizeof(state))) {
        auto try_ptr = [&amp;](uint64_t slot) -&gt; uint32_t {
            if (!PtrOk(slot))
                return 0;
            const uint32_t key = Read&lt;uint32_t&gt;(rd, slot);
            if (!key)
                return 0;
            return GetName(rd, base, 0, key) == &quot;None&quot; ? key : 0;
        };
        uint32_t key = try_ptr(DecodeState(seed, state, StateKind::NameKey));
        if (key)
            return key;
        for (uint32_t i = 0; i &lt; 7; ++i) {
            key = try_ptr(DecodeStateSlot(seed, state, StateKind::NameKey, i));
            if (key)
                return key;
        }
    }
    return RecoverPoolKey(rd, base);
}

inline std::string GetName(const ReadFn&amp; rd, uint64_t base, uint32_t id, uint32_t xorKey, int depth)
{
    if (!xorKey || depth &gt; 8)
        return {};
    const uint64_t chunk = Read&lt;uint64_t&gt;(rd, base + Offsets::GNames + Offsets::NamePoolBlocks + (uint64_t)(id &gt;&gt; 16) * 8);
    if (!PtrOk(chunk))
        return {};
    const uint64_t entry = chunk + (uint64_t)(id &amp; 0xFFFF) * 4;
    const uint16_t header = Read&lt;uint16_t&gt;(rd, entry + 4);
    const uint32_t len = header &gt;&gt; 1;
    const bool wide = (header &amp; 1) != 0;
    if (!len || len &gt; 1024)
        return {};
    const uint32_t bytes = wide ? len * 2 : len;
    uint8_t raw[2048];
    if (bytes &gt; sizeof(raw) || !rd(entry + 6, raw, bytes))
        return {};
    const uint8_t* kb = reinterpret_cast&lt;const uint8_t*&gt;(&amp;xorKey);
    for (uint32_t j = 0; j &lt; len &amp;&amp; j &lt; bytes; ++j)
        raw[j] ^= kb[j &amp; 3] ^ (uint8_t)(len &amp; 0xFF);
    std::string s;
    s.reserve(len);
    if (wide) {
        for (uint32_t i = 0; i + 1 &lt; bytes; i += 2) {
            const uint16_t c = (uint16_t)(raw[i] | (raw[i + 1] &lt;&lt; 8));
            if (!c)
                break;
            s.push_back((c &gt;= 32 &amp;&amp; c &lt; 127) ? (char)c : &#x27;?&#x27;);
        }
    } else {
        for (uint32_t i = 0; i &lt; len; ++i) {
            if (!raw[i])
                break;
            s.push_back((raw[i] &gt;= 32 &amp;&amp; raw[i] &lt; 127) ? (char)raw[i] : &#x27;?&#x27;);
        }
    }
    return s;
}

inline std::string GetObjectName(const ReadFn&amp; rd, uint64_t base, uint64_t object, uint32_t xorKey)
{
    const uint32_t id = Read&lt;uint32_t&gt;(rd, object + Offsets::UObject::Name);
    return GetName(rd, base, id, xorKey);
}

}
</pre>
</div>
<div class="code-block" style="margin-bottom:12px">
<div class="header">Decrypts/GObjects.hpp</div>
<pre>#pragma once

#include &quot;../Offsets.hpp&quot;
#include &quot;State.hpp&quot;

namespace Decrypt::GObjects {

constexpr uint32_t ItemSize = 0x18;

struct Table {
    uint64_t header = 0;
    uint64_t chunks = 0;
    int32_t num = 0;
};

inline Table Load(const ReadFn&amp; rd, uint64_t base)
{
    Table t;
    uint64_t state[7]{};
    if (!rd(base + Offsets::GObjectState, state, sizeof(state)))
        return t;
    const uint32_t key = Read&lt;uint32_t&gt;(rd, base + Offsets::GObjectKey);
    if (!key)
        return t;
    t.header = DecodeState(key, state, StateKind::Objects);
    if (!PtrOk(t.header))
        return t;
    t.chunks = Strip(Read&lt;uint64_t&gt;(rd, t.header));
    t.num = Read&lt;int32_t&gt;(rd, t.header + 0x14);
    return t;
}

inline uint64_t GetObject(const ReadFn&amp; rd, const Table&amp; t, int32_t index)
{
    if (index &lt; 0 || index &gt;= t.num || !PtrOk(t.chunks))
        return 0;
    const uint64_t chunk = Read&lt;uint64_t&gt;(rd, t.chunks + (uint64_t)(index &gt;&gt; 16) * 8);
    if (!PtrOk(Strip(chunk)))
        return 0;
    const uint64_t item = Strip(chunk) + (uint64_t)(index &amp; 0xFFFF) * ItemSize;
    const uint64_t obj = Strip(Read&lt;uint64_t&gt;(rd, item));
    return PtrOk(obj) ? obj : 0;
}

}
</pre>
</div>
<div class="code-block" style="margin-bottom:12px">
<div class="header">Decrypts/GWorld.hpp</div>
<pre>#pragma once

#include &quot;../Offsets.hpp&quot;
#include &quot;State.hpp&quot;

namespace Decrypt::GWorld {

inline uint64_t Get(const ReadFn&amp; rd, uint64_t base)
{
    uint64_t state[7]{};
    if (!rd(base + Offsets::GWorldState, state, sizeof(state)))
        return 0;
    const uint32_t key = Read&lt;uint32_t&gt;(rd, base + Offsets::GWorldKey);
    if (!key)
        return 0;
    auto take = [&amp;](uint64_t slot) -&gt; uint64_t {
        if (!PtrOk(slot))
            return 0;
        const uint64_t w = Strip(Read&lt;uint64_t&gt;(rd, slot));
        return PtrOk(w) ? w : 0;
    };
    uint64_t w = take(DecodeState(key, state, StateKind::World));
    if (w)
        return w;
    for (uint32_t i = 0; i &lt; 7; ++i) {
        w = take(DecodeStateSlot(key, state, StateKind::World, i));
        if (w)
            return w;
    }
    return 0;
}

}
</pre>
</div>
<div class="code-block" style="margin-bottom:12px">
<div class="header">Decrypts/State.hpp</div>
<pre>#pragma once

#include &lt;cstdint&gt;
#include &quot;Common.hpp&quot;

#if defined(_MSC_VER)
#include &lt;intrin.h&gt;
#endif

namespace Decrypt {

inline uint64_t Rol64(uint64_t x, uint32_t n)
{
    n &amp;= 63;
    return n ? ((x &lt;&lt; n) | (x &gt;&gt; (64 - n))) : x;
}

inline uint64_t Ror64(uint64_t x, uint32_t n)
{
    return Rol64(x, 0u - n);
}

inline uint64_t SwapBits(uint64_t x, int shift, uint64_t mask)
{
    return (((x &lt;&lt; shift) ^ (x &gt;&gt; shift)) &amp; mask) ^ (x &gt;&gt; shift);
}

inline uint64_t Permute(uint64_t x)
{
    x = SwapBits(x, 1, 0xAAAAAAAAAAAAAAAAull);
    x = SwapBits(x, 2, 0xCCCCCCCCCCCCCCCCull);
    x = SwapBits(x, 4, 0xF0F0F0F0F0F0F0F0ull);
    x = SwapBits(x, 8, 0xFF00FF00FF00FF00ull);
    return Ror64(x, 32);
}

inline uint64_t PermuteShift2(uint64_t x)
{
    x = SwapBits(x, 2, 0xCCCCCCCCCCCCCCCCull);
    x = SwapBits(x, 4, 0xF0F0F0F0F0F0F0F0ull);
    x = SwapBits(x, 8, 0xFF00FF00FF00FF00ull);
    return Ror64(x, 32);
}

inline uint64_t MulHi64(uint64_t a, uint64_t b)
{
#if defined(_MSC_VER)
    unsigned __int64 hi = 0;
    (void)_umul128(a, b, &amp;hi);
    return hi;
#else
    return (uint64_t)(((__uint128_t)a * b) &gt;&gt; 64);
#endif
}

inline uint32_t MixKey32(uint32_t key)
{
    uint32_t ebx = key;
    uint32_t ecx = key;
    const uint32_t edx = key;
    ebx &lt;&lt;= 25;
    ecx &gt;&gt;= 15;
    ecx ^= edx;
    ecx &gt;&gt;= 12;
    ebx ^= ecx;
    ebx ^= edx;
    return ebx;
}

inline uint32_t ImulSlotIndex(uint32_t mix)
{
    const uint64_t prod = (uint64_t)mix * 0x2545F4914F6CDD1Dull;
    const uint32_t lo = (uint32_t)prod;
    const uint64_t mulhi = MulHi64(prod, 0x2492492492492493ull);
    uint64_t rax = prod - mulhi;
    rax &gt;&gt;= 1;
    rax += mulhi;
    rax &gt;&gt;= 2;
    rax *= 7;
    return lo - (uint32_t)rax;
}

enum class StateKind { World, Objects, NameKey };

inline uint64_t DecodeStateSlot(uint32_t key, const uint64_t state[7], StateKind kind, uint32_t i)
{
    const uint64_t k = key &amp; 0xFFFFFFFFull;
    const uint64_t mixed =
        ((k ^ ((k ^ (k &gt;&gt; 15)) &gt;&gt; 12) ^ ((k &lt;&lt; 25) &amp; 0xFFFFFFFFull)) * 0x2545F4914F6CDD1Dull) &amp; ~0ull;
    const uint32_t high = (uint32_t)(mixed &gt;&gt; 32);
    const uint32_t a = high + i;
    const uint32_t b = high + 2 * i;
    const uint32_t ca = (a % 63) + 1;
    const uint32_t cb = (b % 63) + 1;
    const uint32_t chm = (((high - 1) &amp; 0xFFFFFFFFu) % 63) + 1;
    const uint64_t b64 = (uint64_t)b;
    uint64_t x = state[i] &amp; ~0ull;

    if (kind == StateKind::World) {
        if (i == 0)
            x = (x - 1) &amp; ~0ull;
        else if (i == 1)
            x = Permute(x ^ (~(uint64_t)b));
        else if (i == 2)
            x = Ror64(Ror64(x, cb), ca);
        else if (i == 3)
            x = (~(x ^ (~(uint64_t)b))) &amp; ~0ull;
        else if (i == 4)
            x = x;
        else if (i == 5)
            x = (SwapBits(x, 1, 0xAAAAAAAAAAAAAAAAull) - a) &amp; ~0ull;
        else if (i == 6)
            x = PermuteShift2(x);
    } else if (kind == StateKind::Objects) {
        if (i == 0)
            x = (Permute(x) - high) &amp; ~0ull;
        else if (i == 1)
            x = Permute(Ror64(x, cb));
        else if (i == 2)
            x = (x + i) &amp; ~0ull;
        else if (i == 3)
            x = SwapBits(x ^ (~(uint64_t)b), 1, 0xAAAAAAAAAAAAAAAAull);
        else if (i == 4)
            x = (a + (x ^ (~(uint64_t)b))) &amp; ~0ull;
        else if (i == 5)
            x = (~Permute(x)) &amp; ~0ull;
        else if (i == 6)
            x = (~Ror64(x, cb)) &amp; ~0ull;
    } else {
        if (i == 0)
            x = Permute(Ror64(x, chm));
        else if (i == 1)
            x = Permute(SwapBits(x, 1, 0xAAAAAAAAAAAAAAAAull));
        else if (i == 2)
            x = (Ror64(x, cb) + a) &amp; ~0ull;
        else if (i == 3)
            x = SwapBits((x + b64) &amp; ~0ull, 1, 0xAAAAAAAAAAAAAAAAull);
        else if (i == 4)
            x = Ror64(SwapBits(x, 1, 0xAAAAAAAAAAAAAAAAull), ca);
        else if (i == 5)
            x = Ror64(Permute(x), ca);
        else if (i == 6)
            x = (x ^ a ^ b) &amp; ~0ull;
    }
    return (x ^ k) &amp; ~0ull;
}

inline uint32_t ObjectStateSlot(uint32_t key)
{
    return ImulSlotIndex(MixKey32(key));
}

inline uint64_t DecodeState(uint32_t key, const uint64_t state[7], StateKind kind)
{
    return DecodeStateSlot(key, state, kind, ObjectStateSlot(key));
}

}
</pre>
</div>
                <div style="margin-top:16px">
                    <div style="font-size:11px;color:var(--fg2);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">Constants</div>
                    <div class="offset-group">
<div class="offset-ns">Common / Decrypt</div>
</div>
<div class="offset-group">
<div class="offset-ns">GNames / Decrypt</div>
</div>
<div class="offset-group">
<div class="offset-ns">GObjects / Decrypt</div>
<div class="offset-entry"><span class="offset-name">ItemSize (uint32_t)</span><span class="offset-val">0x18 <button class="copy-btn" onclick="copyVal(this,'0x18')">copy</button></span></div>
</div>
<div class="offset-group">
<div class="offset-ns">GWorld / Decrypt</div>
</div>
<div class="offset-group">
<div class="offset-ns">State / Decrypt</div>
</div>
                </div>
            </div>

            <!-- VALORANT NAMES -->
            <div class="panel" id="panel-valorant-names">
                <div class="dump-controls">
                    <input type="text" id="valorant-name-search" placeholder="Search names..." oninput="valorantNamePage=1;filterValorantNames()">
                    <button onclick="valorantNamePage=1;filterValorantNames()">Reset</button>
                    <button onclick="exportValorantNames()" style="margin-left:auto">Export Names</button>
                </div>
                <div id="valorant-name-count" class="sdk-count"></div>
                <div style="overflow-x:auto">
                    <table class="dump-table">
                        <thead><tr><th>Index</th><th>Name</th></tr></thead>
                        <tbody id="valorant-name-tbody"></tbody>
                    </table>
                </div>
                <div class="pagination" id="valorant-name-pagination"></div>
            </div>

            <!-- VALORANT FUNCTIONS -->
            <div class="panel" id="panel-valorant-functions">
                <div class="dump-controls">
                    <input type="text" id="valorant-func-search" placeholder="Search classes or functions..." oninput="valorantFuncPage=1;filterValorantFunctions()">
                    <button onclick="valorantFuncPage=1;filterValorantFunctions()">Reset</button>
                    <button onclick="exportValorantFunctions()" style="margin-left:auto">Export Functions</button>
                </div>
                <div id="valorant-func-count" class="sdk-count"></div>
                <div class="letter-index" id="valorant-func-letters"></div>
                <div id="valorant-func-list"></div>
                <div class="pagination" id="valorant-func-pagination"></div>
            </div>

            <!-- VALORANT OBJECTS -->
            <div class="panel" id="panel-valorant-objects">
                <div class="dump-controls">
                    <input type="text" id="valorant-obj-search" placeholder="Search by name, type, or index..." oninput="valorantObjPage=1;filterValorantObjects()">
                    <select id="valorant-obj-type" onchange="valorantObjPage=1;filterValorantObjects()">
                        <option value="">All Types</option>
                        <option value="BlueprintGeneratedClass">BlueprintGeneratedClass (20799)</option>
<option value="Class">Class (8901)</option>
<option value="ScriptStruct">ScriptStruct (7463)</option>
<option value="Enum">Enum (2798)</option>
<option value="WidgetBlueprintGeneratedClass">WidgetBlueprintGeneratedClass (2050)</option>
<option value="UserDefinedEnum">UserDefinedEnum (152)</option>
<option value="UserDefinedStruct">UserDefinedStruct (121)</option>
<option value="AnimBlueprintGeneratedClass">AnimBlueprintGeneratedClass (15)</option>
                    </select>
                    <button onclick="valorantObjPage=1;filterValorantObjects()">Reset</button>
                    <button onclick="exportValorantObjects()" style="margin-left:auto">Export Objects</button>
                </div>
                <div id="valorant-obj-count" class="sdk-count"></div>
                <div style="overflow-x:auto">
                    <table class="dump-table">
                        <thead><tr><th>Index</th><th>Type</th><th>Name</th></tr></thead>
                        <tbody id="valorant-obj-tbody"></tbody>
                    </table>
                </div>
                <div class="pagination" id="valorant-obj-pagination"></div>
            </div>

            <!-- VALORANT SDK -->
            <div class="panel" id="panel-valorant-sdk" style="height:calc(100vh - 44px)">
                <div style="display:flex;height:100%;overflow:hidden">
                    <div style="width:320px;min-width:320px;border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden">
                        <div class="sdk-tabs" id="valorant-sdk-tabs">
                            <div class="sdk-tab active" data-cat="Structs" onclick="switchValorantSDKCat('Structs')">Structs<span class="tab-count" id="valorant-sdk-tab-count-Structs"></span></div>
                            <div class="sdk-tab" data-cat="Classes" onclick="switchValorantSDKCat('Classes')">Classes<span class="tab-count" id="valorant-sdk-tab-count-Classes"></span></div>
                            <div class="sdk-tab" data-cat="Enums" onclick="switchValorantSDKCat('Enums')">Enums<span class="tab-count" id="valorant-sdk-tab-count-Enums"></span></div>
                        </div>
                        <div style="padding:12px;border-bottom:1px solid var(--border)">
                            <input type="text" id="valorant-sdk-search" placeholder="Search..." oninput="filterValorantSDK()" style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:4px;color:var(--fg);padding:7px 10px;font-size:12px;font-family:inherit;outline:none">
                        </div>
                        <div id="valorant-sdk-count" style="padding:6px 12px;font-size:11px;color:var(--fg2);border-bottom:1px solid var(--border)"></div>
                        <div id="valorant-sdk-scroll-container" style="flex:1;overflow-y:auto;position:relative">
                            <div id="valorant-sdk-scroll-spacer"></div>
                            <div id="valorant-sdk-list" style="position:absolute;top:0;left:0;right:0"></div>
                        </div>
                    </div>
                    <div style="flex:1;display:flex;flex-direction:column;overflow:hidden">
                        <div id="valorant-sdk-file-header" style="padding:10px 16px;border-bottom:1px solid var(--border);background:var(--bg2);font-size:12px;color:var(--accent);display:flex;align-items:center;gap:8px">
                            <span style="color:var(--fg2)" id="valorant-sdk-file-cat">Struct</span> <span id="valorant-sdk-file-name">Select an item</span>
                        </div>
                        <div id="valorant-sdk-file-content" style="flex:1;overflow:auto;padding:0">
                            <div style="padding:40px;text-align:center;color:var(--fg2);font-size:12px">Click an item on the left to view its content</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- APEX MICS -->
            <div class="panel" id="panel-apex-mics">
                <div style="color:var(--fg2);font-size:12px;margin-bottom:16px">Global pointer offsets for r5apex_dx12.exe</div>
                <table class="dump-table">
                    <thead><tr><th>Name</th><th>Offset</th><th></th></tr></thead>
                    <tbody id="apex-mics-tbody"></tbody>
                </table>
            </div>

            <!-- APEX BUTTONS -->
            <div class="panel" id="panel-apex-buttons">
                <div style="color:var(--fg2);font-size:12px;margin-bottom:16px">Input button command buffer offsets</div>
                <table class="dump-table">
                    <thead><tr><th>Button</th><th>Offset</th><th></th></tr></thead>
                    <tbody id="apex-buttons-tbody"></tbody>
                </table>
            </div>

            <!-- APEX RECVTABLES -->
            <div class="panel" id="panel-apex-recvtables" style="height:calc(100vh - 44px)">
                <div style="display:flex;height:100%;overflow:hidden">
                    <div style="width:320px;min-width:320px;border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden">
                        <div style="padding:12px;border-bottom:1px solid var(--border)">
                            <input type="text" id="apex-rt-search" placeholder="Search tables..." oninput="filterApexRT()" style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:4px;color:var(--fg);padding:7px 10px;font-size:12px;font-family:inherit;outline:none">
                        </div>
                        <div id="apex-rt-count" style="padding:6px 12px;font-size:11px;color:var(--fg2);border-bottom:1px solid var(--border)"></div>
                        <div id="apex-rt-scroll-container" style="flex:1;overflow-y:auto;position:relative">
                            <div id="apex-rt-scroll-spacer"></div>
                            <div id="apex-rt-list" style="position:absolute;top:0;left:0;right:0"></div>
                        </div>
                    </div>
                    <div style="flex:1;display:flex;flex-direction:column;overflow:hidden">
                        <div style="padding:10px 16px;border-bottom:1px solid var(--border);background:var(--bg2);font-size:12px;color:var(--accent);display:flex;align-items:center;gap:8px">
                            <span style="color:var(--fg2)">table</span> <span id="apex-rt-name">Select a table</span>
                        </div>
                        <div id="apex-rt-content" style="flex:1;overflow:auto;padding:0">
                            <div style="padding:40px;text-align:center;color:var(--fg2);font-size:12px">Click a table on the left to view its fields</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- APEX DUMP TXT -->
            <div class="panel" id="panel-apex-dump" style="height:calc(100vh - 44px);overflow:hidden;padding:0;border-top:1px solid var(--border);box-sizing:border-box">
                <div style="display:flex;align-items:center;gap:8px;padding:10px 16px;border-bottom:1px solid var(--border);background:var(--bg2);flex-shrink:0">
                    <div style="color:var(--fg2);font-size:12px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Apex dump entier (r5apex_dx12.exe.txt)</div>
