                    <button onclick="exportOffsets()" style="background:var(--bg3);border:1px solid var(--border);border-radius:4px;color:var(--fg);padding:6px 14px;font-size:12px;font-family:inherit;cursor:pointer;white-space:nowrap">Export Offsets</button>
