// ===== EMBEDDED VERSIONS (set by generate.py) =====

// ===== STATUS CHECK =====
function checkStatus(){
var games=[
    {id:'fortnite',api:'fortnite'},
    {id:'apex',api:'apex_legends'},
    {id:'valorant',api:'valorant'}
];
    games.forEach(function(g){
        var dot=document.getElementById('dot-'+g.id);
        var ver=document.getElementById('ver-'+g.id);
        if(!EMBEDDED_VERSIONS[g.id]){dot.className='status-dot red';return;}
        var url='https://agametracker.iamstern.xyz/api/status?game='+g.api;
        fetch(url).then(function(r){return r.json()}).then(function(data){
            var live=extractVersion(g.id,data);
            var embedded=EMBEDDED_VERSIONS[g.id];
            if(ver)ver.textContent=embedded;
            if(live===embedded){
                dot.className='status-dot green';
            }else{
                dot.className='status-dot red';
                dot.title='New version available: '+live;
            }
        }).catch(function(){
            dot.className='status-dot red';
            dot.title='Could not check version';
        });
    });
}
function extractVersion(game,data){
    return data.buildVersion||'';
}

// ===== API DOCS =====
var API_ENDPOINTS = [
    {path:'api/manifest.json', desc:'API metadata, counters and endpoint list'},
    {path:'api/offsets.json', desc:'Offsets grouped by namespace + raw Offsets.hpp'},
    {path:'api/decrypts.json', desc:'Decrypt constants by file/namespace + raw headers'},
    {path:'api/names.json', desc:'GNames name pool: [{index, name}]'},
    {path:'api/objects.json', desc:'GObjects dump: [{index, type, name}]'},
    {path:'api/typeCounts.json', desc:'Object type breakdown: {type: count}'},
    {path:'api/functions.json', desc:'UFunctions grouped by class: {class: [{name, flags}]}'},
    {path:'api/sdk.json', desc:'SDK type index (names only): {Classes, Structs, Enums}'},
    {path:'api/sdkContent.json', desc:'Full SDK header sources — split across 5 parts (.part0..part4, merge and JSON.parse each)'},
    {path:'api/apex.json', desc:'Apex dump: mics, buttons, recvTables, convars, stats'}
];

function renderDocsEndpoints(){
    var host=document.getElementById('docs-endpoints');
    if(!host||host.dataset.rendered)return;
    var html='';
    API_ENDPOINTS.forEach(function(e,i){
        html+='<div class="docs-endpoint" id="docs-ep-'+i+'">'
            +'<div class="docs-endpoint-head" onclick="toggleDocsEndpoint('+i+')">'
            +'<span class="docs-method">GET</span>'
            +'<span class="docs-path">'+e.path+'</span>'
            +'<span class="docs-desc">'+e.desc+'</span>'
            +'<span class="docs-arrow">\u25B6</span>'
            +'</div>'
            +'<div class="docs-endpoint-body">'
            +'<div class="docs-curl">'
            +'<pre>curl -s "<span class="docs-base-path">&lt;BASE_URL&gt;</span>/'+e.path+'" | head -c 400</pre>'
            +'<button class="copy-btn" style="opacity:1" onclick="copyVal(this, this.closest(\'.docs-curl\').querySelector(\'pre\').textContent.trim())">copy</button>'
            +'</div>'
            +'<div class="docs-try">'
            +'<button onclick="tryDocsEndpoint('+i+')">Try it</button>'
            +'<span style="font-size:11px;color:var(--fg2)">fetches the real file and shows the first 400 chars of JSON</span>'
            +'</div>'
            +'<div class="docs-try-result" id="docs-try-'+i+'"></div>'
            +'</div>'
            +'</div>';
    });
    host.innerHTML=html;
    host.dataset.rendered='1';
}

function toggleDocsEndpoint(i){
    var el=document.getElementById('docs-ep-'+i);
    if(el)el.classList.toggle('open');
}

function tryDocsEndpoint(i){
    var e=API_ENDPOINTS[i];
    var out=document.getElementById('docs-try-'+i);
    if(!out)return;
    out.style.display='block';
    out.textContent='Fetching '+e.path+'...';
    fetch(e.path).then(function(r){
        if(!r.ok)throw new Error('HTTP '+r.status);
        return r.text();
    }).then(function(t){
        out.textContent=t.slice(0,400)+((t.length>400)?'\n... ('+t.length.toLocaleString()+' chars total)':'');
    }).catch(function(err){
        out.textContent='Error: '+err.message+(location.protocol==='file:'?' (make sure site/local/api/ exists next to the page)':'');
    });
}

// ===== NAVIGATION =====
var currentSection = 'overview';
function showSection(s){
    currentSection = s;
    document.querySelectorAll('.panel').forEach(function(p){p.classList.remove('active')});
    document.getElementById('panel-'+s).classList.add('active');
    document.querySelectorAll('.nav-item').forEach(function(n){n.classList.remove('active')});
    var navItem = document.querySelector('.nav-item[data-section="'+s+'"]');
    if(navItem) navItem.classList.add('active');
    var names={overview:'Overview',basic:'Basic Types',docs:'API Docs',offsets:'Offsets',decrypts:'Decrypts',names:'Names',functions:'Functions',objects:'Objects',sdk:'SDK','apex-mics':'Global Pointers','apex-buttons':'Buttons','apex-recvtables':'RecvTables','apex-convars':'Convars'};
    document.getElementById('breadcrumb').innerHTML='<span>'+(names[s]||s)+'</span>';
    document.getElementById('content').scrollTop=0;
    if(s==='sdk')setTimeout(function(){sdkRenderVirtual()},50);
    if(s==='docs')renderDocsEndpoints();
}

// ===== NAMES =====
var namePage=1, namePageSize=200, nameFiltered=null;
function filterNames(){
    var q=document.getElementById('name-search').value.toLowerCase();
    nameFiltered=q?nameData.filter(function(e){return e[1].toLowerCase().indexOf(q)!==-1}):nameData;
    namePage=1;renderNames();
}
function renderNames(){
    if(!nameFiltered)nameFiltered=nameData;
    var total=nameFiltered.length,pages=Math.ceil(total/namePageSize);
    if(namePage>pages)namePage=pages||1;
    var s=(namePage-1)*namePageSize,e=Math.min(s+namePageSize,total),rows='';
    for(var i=s;i<e;i++){
        var n=nameFiltered[i];
        rows+='<tr><td class="idx">'+n[0]+'</td><td class="name">'+esc(n[1])+'</td></tr>';
    }
    document.getElementById('name-tbody').innerHTML=rows;
    document.getElementById('name-count').textContent='Showing '+(s+1)+'-'+e+' of '+total.toLocaleString()+' names';
    renderPagination('name-pagination',namePage,pages,function(p){namePage=p;renderNames()});
}

// ===== FUNCTIONS =====
var funcPage=1,funcPageSize=50,funcFiltered=null,funcLetter='';
function filterFunctions(){
    var q=document.getElementById('func-search').value.toLowerCase();
    var keys=Object.keys(funcData);
    funcFiltered=q?keys.filter(function(k){
        if(k.toLowerCase().indexOf(q)!==-1)return true;
        return funcData[k].some(function(f){return f[0].toLowerCase().indexOf(q)!==-1});
    }):keys;
    funcPage=1;renderFunctions();
}
function renderFunctions(){
    if(!funcFiltered)funcFiltered=Object.keys(funcData);
    var filtered=funcFiltered;
    if(funcLetter)filtered=filtered.filter(function(k){
        var c=k[0]?k[0].toUpperCase():'#';
        return c.match(/[A-Z]/)?c===funcLetter:c==='#'&&funcLetter==='#';
    });
    var total=filtered.length,pages=Math.ceil(total/funcPageSize);
    if(funcPage>pages)funcPage=pages||1;
    var s=(funcPage-1)*funcPageSize,e=Math.min(s+funcPageSize,total),html='';
    for(var i=s;i<e;i++){
        var cls=filtered[i],funcs=funcData[cls];
        html+='<div class="offset-group"><div class="offset-ns">'+esc(cls)+' ('+funcs.length+' functions)</div>';
        funcs.forEach(function(f){
            html+='<div class="offset-entry"><span class="name">'+esc(f[0])+'</span><span class="flags">'+f[1]+'</span></div>';
        });
        html+='</div>';
    }
    document.getElementById('func-list').innerHTML=html;
    document.getElementById('func-count').textContent='Showing '+(s+1)+'-'+e+' of '+total.toLocaleString()+' classes';
    renderPagination('func-pagination',funcPage,pages,function(p){funcPage=p;renderFunctions()});
}
function initFuncLetters(){
    var c=document.getElementById('func-letters'),letters={};
    Object.keys(funcData).forEach(function(k){
        var ch=k[0]?k[0].toUpperCase():'#';
        if(!ch.match(/[A-Z]/))ch='#';
        letters[ch]=true;
    });
    Object.keys(letters).sort().forEach(function(l){
        var btn=document.createElement('button');
        btn.textContent=l;
        btn.onclick=function(){
            funcLetter=funcLetter===l?'':l;
            funcPage=1;
            c.querySelectorAll('button').forEach(function(b){b.classList.remove('active')});
            if(funcLetter)btn.classList.add('active');
            renderFunctions();
        };
        c.appendChild(btn);
    });
}

// ===== OBJECTS =====
var objPage=1,objPageSize=500,objFiltered=null;
function filterObjects(){
    var q=document.getElementById('obj-search').value.toLowerCase();
    var t=document.getElementById('obj-type').value;
    objFiltered=objData;
    if(t)objFiltered=objFiltered.filter(function(e){return e[2]===t});
    if(q)objFiltered=objFiltered.filter(function(e){
        return e[3].toLowerCase().indexOf(q)!==-1||e[2].toLowerCase().indexOf(q)!==-1||String(e[0]).indexOf(q)!==-1;
    });
    objPage=1;renderObjects();
}
function renderObjects(){
    if(!objFiltered)objFiltered=objData;
    var total=objFiltered.length,pages=Math.ceil(total/objPageSize);
    if(objPage>pages)objPage=pages||1;
    var s=(objPage-1)*objPageSize,e=Math.min(s+objPageSize,total),rows='';
    for(var i=s;i<e;i++){
        var n=objFiltered[i];
        rows+='<tr><td class="idx">'+n[0]+'</td><td class="type">'+esc(n[2])+'</td><td class="name">'+esc(n[3])+'</td></tr>';
    }
    document.getElementById('obj-tbody').innerHTML=rows;
    document.getElementById('obj-count').textContent='Showing '+(s+1)+'-'+e+' of '+total.toLocaleString()+' objects';
    renderPagination('obj-pagination',objPage,pages,function(p){objPage=p;renderObjects()});
}

// ===== SDK =====
var sdkCat='Structs',sdkFiltered=null,sdkSelected='',sdkItemH=32;
function switchSDKCat(cat){
    sdkCat=cat;
    sdkSelected='';
    document.querySelectorAll('.sdk-tab').forEach(function(t){t.classList.toggle('active',t.getAttribute('data-cat')===cat)});
    document.getElementById('sdk-file-name').textContent='Select an item';
    document.getElementById('sdk-file-cat').textContent=cat.slice(0,-1);
    document.getElementById('sdk-file-content').innerHTML='<div style="padding:40px;text-align:center;color:var(--fg2);font-size:12px">Click an item on the left to view its content</div>';
    document.getElementById('sdk-search').value='';
    filterSDK();
}
function initSDKTabs(){
    var cats=['Structs','Classes','Enums'];
    cats.forEach(function(c){
        var el=document.getElementById('sdk-tab-count-'+c);
        if(el)el.textContent=' ('+((sdkData[c]||[]).length)+')';
    });
}
function filterSDK(){
    var q=document.getElementById('sdk-search').value.toLowerCase();
    var all=sdkData[sdkCat]||[];
    sdkFiltered=q?all.filter(function(k){return k.toLowerCase().indexOf(q)!==-1}):all.slice();
    document.getElementById('sdk-count').textContent=sdkFiltered.length+' items';
    sdkRenderVirtual();
}
function sdkRenderVirtual(){
    var container=document.getElementById('sdk-scroll-container');
    var list=document.getElementById('sdk-list');
    var spacer=document.getElementById('sdk-scroll-spacer');
    var total=sdkFiltered?sdkFiltered.length:0;
    spacer.style.height=(total*sdkItemH)+'px';
    var scrollTop=container.scrollTop;
    var viewH=container.clientHeight;
    var start=Math.max(0,Math.floor(scrollTop/sdkItemH)-10);
    var end=Math.min(total,Math.ceil((scrollTop+viewH)/sdkItemH)+10);
    var html='';
    for(var i=start;i<end;i++){
        var name=sdkFiltered[i];
        var key=sdkCat+'/'+name;
        var cls=key===sdkSelected?'sdk-file-item selected':'sdk-file-item';
        html+='<div class="'+cls+'" onclick="selectSDK(\''+esc(name)+'\')">'+esc(name)+'</div>';
    }
    list.innerHTML=html;
    list.style.top=(start*sdkItemH)+'px';
}
function highlightSDK(code){
    var escRe=[/&/g,/</g,/>/g,/"/g];
    var escFn=function(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');};
    var lines=code.split('\n');
    var out=[];
    for(var li=0;li<lines.length;li++){
        var ln=lines[li];
        // full-line comment
        if(/^\s*\/\//.test(ln)){out.push('<span class="sdk-hl-cmt">'+escFn(ln)+'</span>');continue;}
        // full-line preprocessor
        if(/^\s*#/.test(ln)){out.push('<span class="sdk-hl-pre">'+escFn(ln)+'</span>');continue;}
        // full-line brace
        if(/^\s*[{}]\s*$/.test(ln)){out.push(escFn(ln));continue;}
        // process tokens
        var tokens=[];var pos=0;
        while(pos<ln.length){
            // inline comment
            if(ln[pos]==='/'&&pos+1<ln.length&&ln[pos+1]==='/'){
                tokens.push('<span class="sdk-hl-cmt">'+escFn(ln.substring(pos))+'</span>');pos=ln.length;continue;}
            // block comment start
            if(ln[pos]==='/'&&pos+1<ln.length&&ln[pos+1]==='*'){
                var end=ln.indexOf('*/',pos+2);if(end===-1)end=ln.length-2;else end+=2;
                tokens.push('<span class="sdk-hl-cmt">'+escFn(ln.substring(pos,end))+'</span>');pos=end;continue;}
            // string
            if(ln[pos]==='"'){
                var s2=ln.indexOf('"',pos+1);while(s2!==-1&&ln[s2-1]==='\\')s2=ln.indexOf('"',s2+1);
                if(s2===-1)s2=ln.length;else s2++;tokens.push('<span class="sdk-hl-str">'+escFn(ln.substring(pos,s2))+'</span>');pos=s2;continue;}
            // number
            if(/[0-9]/.test(ln[pos])&&(pos===0||/[\s,<>(){}\[*&|=!+\-]/.test(ln[pos-1]))){
                var m=ln.substring(pos).match(/^(0x[0-9a-fA-F]+|[0-9]+[uUlL]*)/);
                if(m){tokens.push('<span class="sdk-hl-num">'+escFn(m[0])+'</span>');pos+=m[0].length;continue;}}
            // word
            if(/[A-Za-z_]/.test(ln[pos])){
                var w='';while(pos<ln.length&&/[A-Za-z0-9_]/.test(ln[pos])){w+=ln[pos];pos++;}
                // Check if followed by : for offset annotation
                var rest=ln.substring(pos);
                if(rest.match(/^\s*Offset:/)||rest.match(/^\s*Size:/)){
                    tokens.push('<span class="sdk-hl-off">'+escFn(w)+'</span>');continue;}
                // Check if next non-space is '(' => function
                var nxt=rest.match(/^\s*\(/);
                if(nxt){
                    // lookbehind: if preceded by type keyword, highlight as type
                    var last=tokens.length-1;var prevIsType=last>=0&&(tokens[last].indexOf('sdk-hl-type')!==-1||tokens[last].indexOf('sdk-hl-kw')!==-1);
                    tokens.push('<span class="'+(prevIsType?'sdk-hl-type':'sdk-hl-type')+'">'+escFn(w)+'</span>');continue;}
                // keyword check
                var kw={'struct':1,'class':1,'enum':1,'public':1,'private':1,'protected':1,'void':1,'return':1,'if':1,'else':1,'for':1,'while':1,'do':1,'switch':1,'case':1,'break':1,'continue':1,'typedef':1,'using':1,'namespace':1,'template':1,'typename':1,'constexpr':1,'const':1,'static':1,'virtual':1,'override':1,'inline':1,'volatile':1,'mutable':1,'explicit':1,'friend':1,'operator':1,'new':1,'delete':1,'nullptr':1,'true':1,'false':1,'this':1,'sizeof':1,'typeof':1,'decltype':1,'auto':1};
                if(kw[w]){tokens.push('<span class="sdk-hl-kw">'+escFn(w)+'</span>');continue;}
                // type check
                var types={'uint8_t':1,'uint16_t':1,'uint32_t':1,'uint64_t':1,'int8_t':1,'int16_t':1,'int32_t':1,'int64_t':1,'float':1,'double':1,'bool':1,'char':1,'wchar_t':1,'TArray':1,'TMap':1,'TSet':1,'TWeakObjectPtr':1,'TSoftObjectPtr':1,'TSoftClassPtr':1,'TScriptInterface':1,'FString':1,'FName':1,'FText':1,'FVector':1,'FRotator':1,'FTransform':1,'FHitResult':1,'FKey':1,'FVector2D':1,'FVector4':1,'FLinearColor':1,'FQuat':1,'FBox':1,'FSphere':1,'FPlane':1,'FMatrix':1,'FColor':1,'FDateTime':1,'FTimespan':1,'FGuid':1,'FRandomStream':1,'FMulticastScriptDelegate':1,'FScriptDelegate':1,'TEnumAsByte':1,'TSubclassOf':1,'TSoftClassPtr':1,'UObject':1,'UClass':1,'UFunction':1,'UProperty':1,'UField':1,'UActorComponent':1,'USceneComponent':1,'UPrimitiveComponent':1,'AActor':1,'AController':1,'APawn':1,'APlayerController':1,'UWorld':1,'UObject*':1,'UClass*':1};
                if(types[w]){tokens.push('<span class="sdk-hl-type">'+escFn(w)+'</span>');continue;}
                tokens.push(escFn(w));continue;}
            // other char
            tokens.push(escFn(ln[pos]));pos++;}
        out.push(tokens.join(''));}
    return out.join('\n');}
function selectSDK(name){
    var key=sdkCat+'/'+name;
    sdkSelected=key;
    document.getElementById('sdk-file-name').textContent=name;
    document.getElementById('sdk-file-cat').textContent=sdkCat.slice(0,-1);
    var content=sdkContent[key]||'// No content available';
    document.getElementById('sdk-file-content').innerHTML='<pre style="margin:0;padding:16px;font-size:12px;line-height:1.6;color:var(--fg);white-space:pre;overflow-x:auto">'+highlightSDK(content)+'</pre>';
    sdkRenderVirtual();
}

// ===== UTILS =====
function esc(s){return s?s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'):'';}
function renderPagination(id,current,total,callback){
    var el=document.getElementById(id);
    if(total<=1){el.innerHTML='';return;}
    var h='<button '+(current===1?'disabled':'')+' data-p="prev">Prev</button>';
    var range=5,start=Math.max(1,current-range),end=Math.min(total,current+range);
    if(start>1)h+='<button data-p="1">1</button><span class="info">...</span>';
    for(var i=start;i<=end;i++)h+='<button data-p="'+i+'"'+(i===current?' class="active"':'')+'>'+i+'</button>';
    if(end<total)h+='<span class="info">...</span><button data-p="'+total+'">'+total+'</button>';
    h+='<button '+(current===total?'disabled':'')+' data-p="next">Next</button>';
    h+='<span class="info">'+total+' pages</span>';
    el.innerHTML=h;
    el.querySelectorAll('button').forEach(function(btn){
        btn.onclick=function(){
            var p=btn.getAttribute('data-p');
            if(p==='prev')callback(current-1);
            else if(p==='next')callback(current+1);
            else{var n=parseInt(p);if(!isNaN(n))callback(n);}
        };
    });
}

// ===== COPY =====
function copyVal(btn, val){
    navigator.clipboard.writeText(val).then(function(){
        btn.textContent='copied';
        btn.classList.add('copied');
        setTimeout(function(){btn.textContent='copy';btn.classList.remove('copied');},1500);
    });
}

// ===== EXPORT OFFSETS =====
function exportOffsets(){
    var text='// Auto-generated by HWIDR SDK Dumper\n#pragma once\n#include <cstdint>\n\nnamespace Offsets {\n\n';
    var els=document.querySelectorAll('#panel-offsets .offset-group');
    els.forEach(function(g){
        var ns=g.querySelector('.offset-ns').textContent.trim();
        text+='namespace '+ns+' {\n';
        g.querySelectorAll('.offset-entry').forEach(function(e){
            var name=e.querySelector('.offset-name').textContent.trim();
            var val=e.querySelector('.offset-val').childNodes[0].textContent.trim();
            var type=val.startsWith('0x')&&val.length<=10?'uint32_t':'uint64_t';
            if(ns==='Global')type='uint64_t';
            text+='    constexpr '+type+' '+name+' = '+val+';\n';
        });
        text+='}\n\n';
    });
    text+='}\n';
    var blob=new Blob([text],{type:'text/plain'});
    var a=document.createElement('a');
    a.href=URL.createObjectURL(blob);
    a.download='Offsets.hpp';
    a.click();
    URL.revokeObjectURL(a.href);
}

// ===== COPY OFFSETS =====
function copyOffsets(){
    var text='// Offsets.hpp\n#pragma once\n#include <cstdint>\n\nnamespace Offsets {\n\n';
    var els=document.querySelectorAll('#panel-offsets .offset-group');
    els.forEach(function(g){
        var ns=g.querySelector('.offset-ns').textContent.trim();
        text+='namespace '+ns+' {\n';
        g.querySelectorAll('.offset-entry').forEach(function(e){
            var name=e.querySelector('.offset-name').textContent.trim();
            var val=e.querySelector('.offset-val').textContent.trim();
            var type=val.startsWith('0x')&&val.length<=10?'uint32_t':'uint64_t';
            if(ns==='Global')type='uint64_t';
            text+='    constexpr '+type+' '+name+' = '+val+';\n';
        });
        text+='}\n\n';
    });
    text+='}\n';
    navigator.clipboard.writeText(text).then(function(){
        var btn=document.querySelector('#panel-offsets button');
        btn.textContent='Copied!';
        btn.style.color='var(--accent)';
        setTimeout(function(){btn.textContent='Copy Offsets';btn.style.color='var(--fg)';},2000);
    });
}

// ===== EXPORT NAMES =====
function exportNames(){
    var text='// NameDump.txt\n';
    nameData.forEach(function(e){text+='['+e[0]+'] '+e[1]+'\n';});
    downloadText('NameDump.txt', text);
}

// ===== EXPORT FUNCTIONS =====
function exportFunctions(){
    var text='// FunctionsDump.txt\n';
    var keys=Object.keys(funcData).sort();
    keys.forEach(function(cls){
        text+='['+cls+']\n';
        funcData[cls].forEach(function(f){text+=f[0]+' flags='+f[1]+'\n';});
    });
    downloadText('FunctionsDump.txt', text);
}

// ===== EXPORT OBJECTS =====
function exportObjects(){
    var text='// ObjectDump.txt\n';
    objData.forEach(function(e){text+='['+e[0]+'] '+e[1]+' '+e[2]+' '+e[3]+'\n';});
    downloadText('ObjectDump.txt', text);
}

// ===== EXPORT APEX DUMP =====
function exportApexDump(){
    if(!apexData)return;
    var text='';
    text+='[Mics]\n';
    apexData.mics.forEach(function(e){text+=e[0]+' = '+e[1]+'\n';});
    text+='\n[Buttons]\n';
    apexData.buttons.forEach(function(e){text+=e[0]+' = '+e[1]+'\n';});
    text+='\n[RecvTable]\n';
    var keys=Object.keys(apexData.recvTables).sort();
    keys.forEach(function(tbl){
        text+='['+tbl+']\n';
        apexData.recvTables[tbl].forEach(function(f){text+=f[0]+' = '+f[1]+'\n';});
    });
    downloadText('r5apex_dx12.exe.txt', text);
}

// ===== DOWNLOAD HELPER =====
function downloadText(filename, text){
    var blob=new Blob([text],{type:'text/plain'});
    var a=document.createElement('a');
    a.href=URL.createObjectURL(blob);
    a.download=filename;
    a.click();
    URL.revokeObjectURL(a.href);
}

// ===== GAME SWITCHING =====
var currentGame = 'fortnite';

function formatBytes(bytes){
    if(!bytes||bytes==='0')return '-';
    var b=parseInt(bytes);
    if(isNaN(b))return bytes;
    if(b>=1e12)return(b/1e12).toFixed(2)+' TB';
    if(b>=1e9)return(b/1e9).toFixed(2)+' GB';
    if(b>=1e6)return(b/1e6).toFixed(2)+' MB';
    return(b/1e3).toFixed(1)+' KB';
}
function formatDate(iso){
    if(!iso)return '-';
    try{
        var d=new Date(iso);
        var dd=String(d.getDate()).padStart(2,'0');
        var mm=String(d.getMonth()+1).padStart(2,'0');
        var yyyy=d.getFullYear();
        var hh=String(d.getHours()).padStart(2,'0');
        var mi=String(d.getMinutes()).padStart(2,'0');
        var ss=String(d.getSeconds()).padStart(2,'0');
        return dd+'/'+mm+'/'+yyyy+' '+hh+':'+mi+':'+ss;
    }catch(e){return iso;}
}
function formatBuildName(v){
    if(!v)return '-';
    return v.replace(/\+/g,' ').replace(/^ Fortnite Release/,'Fortnite Release');
}
function fetchBuildStatus(game){
    var url='https://agametracker.iamstern.xyz/api/status?game='+game;
    fetch(url).then(function(r){return r.json()}).then(function(data){
        if(game==='fortnite'){
            document.getElementById('build-hash').textContent=data.buildVersion||'-';
            document.getElementById('build-target').textContent='FortniteClient-Win64-Shipping.exe';
            document.getElementById('build-size').textContent=formatBytes(data.downloadSize);
            document.getElementById('build-date').textContent=formatDate(data.lastUpdated);
        }
        if(game==='apex_legends'){
            document.getElementById('build-hash-apex').textContent=data.buildVersion||'-';
            document.getElementById('build-target-apex').textContent='r5apex_dx12.exe';
            document.getElementById('build-size-apex').textContent=formatBytes(data.buildSize);
            document.getElementById('build-date-apex').textContent=formatDate(data.lastUpdated);
        }
        if(game==='valorant'){
            document.getElementById('build-hash-valorant').textContent=data.buildVersion||'-';
            document.getElementById('build-target-valorant').textContent='VALORANT-Win64-Shipping.exe';
            document.getElementById('build-size-valorant').textContent=formatBytes(data.buildSize);
            document.getElementById('build-date-valorant').textContent=formatDate(data.lastUpdated);
        }
    }).catch(function(){
        document.getElementById('build-hash').textContent='Offline';
        document.getElementById('build-target').textContent='-';
        document.getElementById('build-size').textContent='-';
        document.getElementById('build-date').textContent='-';
        document.getElementById('build-hash-apex').textContent='Offline';
        document.getElementById('build-target-apex').textContent='-';
        document.getElementById('build-size-apex').textContent='-';
        document.getElementById('build-date-apex').textContent='-';
        document.getElementById('build-hash-valorant').textContent='Offline';
        document.getElementById('build-target-valorant').textContent='-';
        document.getElementById('build-size-valorant').textContent='-';
        document.getElementById('build-date-valorant').textContent='-';
    });
}
function switchGame(game){
    currentGame = game;
    document.querySelectorAll('.game-btn').forEach(function(b){b.classList.toggle('active',b.textContent.toLowerCase().indexOf(game)!==-1)});
    document.querySelectorAll('.nav-game').forEach(function(n){n.classList.toggle('active',n.getAttribute('data-game')===game)});
    document.getElementById('sidebar-subtitle').textContent=game==='fortnite'?'Fortnite Dumper Viewer':game==='apex'?'Apex Legends Dumper Viewer':'Valorant Dumper Viewer';
    document.getElementById('overview-fortnite').style.display=game==='fortnite'?'':'none';
    document.getElementById('overview-apex').style.display=game==='apex'?'':'none';
    document.getElementById('overview-valorant').style.display=game==='valorant'?'':'none';
    fetchBuildStatus(game==='apex'?'apex_legends':game==='valorant'?'valorant':'fortnite');
    if(game==='apex'){
        renderApexOverview();
        filterApexMics();
        filterApexButtons();
        filterApexRT();
    }
    if(game==='valorant'){
        filterValorantNames();
        filterValorantFunctions();
        filterValorantObjects();
        initValorantFuncLetters();
        initValorantSDKTabs();
        filterValorantSDK();
    }
    showSection('overview');
}

// ===== APEX OVERVIEW =====
function renderApexOverview(){
    if(!apexData)return;
    var s=apexData.stats;
    var html='<div class="stat-card"><div class="label">Global Pointers</div><div class="value">'+s.mics+'</div><div class="detail">Mics offsets</div></div>';
    html+='<div class="stat-card"><div class="label">Input Buttons</div><div class="value">'+s.buttons+'</div><div class="detail">Button bindings</div></div>';
    html+='<div class="stat-card"><div class="label">RecvTables</div><div class="value">'+s.tables+'</div><div class="detail">Network tables</div></div>';
    html+='<div class="stat-card"><div class="label">Total Fields</div><div class="value">'+s.totalFields.toLocaleString()+'</div><div class="detail">Networked properties</div></div>';
    document.getElementById('apex-stats-grid').innerHTML=html;
}

// ===== APEX MICS =====
function filterApexMics(){
    if(!apexData)return;
    var rows='';
    apexData.mics.forEach(function(e){
        rows+='<tr><td class="name">'+esc(e[0])+'</td><td class="addr">'+e[1]+'</td><td><button class="copy-btn" onclick="copyVal(this,\''+e[1]+'\')">copy</button></td></tr>';
    });
    document.getElementById('apex-mics-tbody').innerHTML=rows;
}

// ===== APEX BUTTONS =====
function filterApexButtons(){
    if(!apexData)return;
    var rows='';
    apexData.buttons.forEach(function(e){
        rows+='<tr><td class="name">'+esc(e[0])+'</td><td class="addr">'+e[1]+'</td><td><button class="copy-btn" onclick="copyVal(this,\''+e[1]+'\')">copy</button></td></tr>';
    });
    document.getElementById('apex-buttons-tbody').innerHTML=rows;
}

// ===== APEX RECVTABLES =====
var apexRTFiltered=null,apexRTSelected='',apexRTItemH=32;
function filterApexRT(){
    if(!apexData)return;
    var q=document.getElementById('apex-rt-search').value.toLowerCase();
    var keys=Object.keys(apexData.recvTables);
    apexRTFiltered=q?keys.filter(function(k){return k.toLowerCase().indexOf(q)!==-1}):keys.slice();
    document.getElementById('apex-rt-count').textContent=apexRTFiltered.length+' tables';
    apexRTRenderVirtual();
}
function apexRTRenderVirtual(){
    var container=document.getElementById('apex-rt-scroll-container');
    var list=document.getElementById('apex-rt-list');
    var spacer=document.getElementById('apex-rt-scroll-spacer');
    var total=apexRTFiltered?apexRTFiltered.length:0;
    spacer.style.height=(total*apexRTItemH)+'px';
    var scrollTop=container.scrollTop;
    var viewH=container.clientHeight;
    var start=Math.max(0,Math.floor(scrollTop/apexRTItemH)-10);
    var end=Math.min(total,Math.ceil((scrollTop+viewH)/apexRTItemH)+10);
    var html='';
    for(var i=start;i<end;i++){
        var name=apexRTFiltered[i];
        var cls=name===apexRTSelected?'sdk-file-item selected':'sdk-file-item';
        html+='<div class="'+cls+'" onclick="selectApexRT(\''+esc(name)+'\')">'+esc(name)+'</div>';
    }
    list.innerHTML=html;
    list.style.top=(start*apexRTItemH)+'px';
}
function selectApexRT(name){
    apexRTSelected=name;
    document.getElementById('apex-rt-name').textContent=name;
    var fields=apexData.recvTables[name]||[];
    var html='<table class="dump-table"><thead><tr><th>Field</th><th>Offset</th><th></th></tr></thead><tbody>';
    fields.forEach(function(f){
        html+='<tr><td class="name">'+esc(f[0])+'</td><td class="addr">'+f[1]+'</td><td><button class="copy-btn" onclick="copyVal(this,\''+f[1]+'\')">copy</button></td></tr>';
    });
    html+='</tbody></table>';
    document.getElementById('apex-rt-content').innerHTML=html;
    apexRTRenderVirtual();
}

// ===== VALORANT NAMES =====
var valorantNamePage=1, valorantNamePageSize=200, valorantNameFiltered=null;
function filterValorantNames(){
    var q=document.getElementById('valorant-name-search').value.toLowerCase();
    valorantNameFiltered=q?valorantNameData.filter(function(e){return e[1].toLowerCase().indexOf(q)!==-1}):valorantNameData;
    valorantNamePage=1;renderValorantNames();
}
function renderValorantNames(){
    if(!valorantNameFiltered)valorantNameFiltered=valorantNameData;
    var total=valorantNameFiltered.length,pages=Math.ceil(total/valorantNamePageSize);
    if(valorantNamePage>pages)valorantNamePage=pages||1;
    var s=(valorantNamePage-1)*valorantNamePageSize,e=Math.min(s+valorantNamePageSize,total),rows='';
    for(var i=s;i<e;i++){
        var n=valorantNameFiltered[i];
        rows+='<tr><td class="idx">'+n[0]+'</td><td class="name">'+esc(n[1])+'</td></tr>';
    }
    document.getElementById('valorant-name-tbody').innerHTML=rows;
    document.getElementById('valorant-name-count').textContent='Showing '+(s+1)+'-'+e+' of '+total.toLocaleString()+' names';
    renderPagination('valorant-name-pagination',valorantNamePage,pages,function(p){valorantNamePage=p;renderValorantNames()});
}

// ===== VALORANT FUNCTIONS =====
var valorantFuncPage=1,valorantFuncPageSize=50,valorantFuncFiltered=null,valorantFuncLetter='';
function filterValorantFunctions(){
    var q=document.getElementById('valorant-func-search').value.toLowerCase();
    var keys=Object.keys(valorantFuncData);
    valorantFuncFiltered=q?keys.filter(function(k){
        if(k.toLowerCase().indexOf(q)!==-1)return true;
        return valorantFuncData[k].some(function(f){return f[0].toLowerCase().indexOf(q)!==-1});
    }):keys;
    valorantFuncPage=1;renderValorantFunctions();
}
function renderValorantFunctions(){
    if(!valorantFuncFiltered)valorantFuncFiltered=Object.keys(valorantFuncData);
    var filtered=valorantFuncFiltered;
    if(valorantFuncLetter)filtered=filtered.filter(function(k){
        var c=k[0]?k[0].toUpperCase():'#';
        return c.match(/[A-Z]/)?c===valorantFuncLetter:c==='#'&&valorantFuncLetter==='#';
    });
    var total=filtered.length,pages=Math.ceil(total/valorantFuncPageSize);
    if(valorantFuncPage>pages)valorantFuncPage=pages||1;
    var s=(valorantFuncPage-1)*valorantFuncPageSize,e=Math.min(s+valorantFuncPageSize,total),html='';
    for(var i=s;i<e;i++){
        var cls=filtered[i],funcs=valorantFuncData[cls];
        html+='<div class="offset-group"><div class="offset-ns">'+esc(cls)+' ('+funcs.length+' functions)</div>';
        funcs.forEach(function(f){
            html+='<div class="offset-entry"><span class="name">'+esc(f[0])+'</span><span class="flags">'+f[1]+'</span></div>';
        });
        html+='</div>';
    }
    document.getElementById('valorant-func-list').innerHTML=html;
    document.getElementById('valorant-func-count').textContent='Showing '+(s+1)+'-'+e+' of '+total.toLocaleString()+' classes';
    renderPagination('valorant-func-pagination',valorantFuncPage,pages,function(p){valorantFuncPage=p;renderValorantFunctions()});
}
function initValorantFuncLetters(){
    var c=document.getElementById('valorant-func-letters'),letters={};
    Object.keys(valorantFuncData).forEach(function(k){
        var ch=k[0]?k[0].toUpperCase():'#';
        if(!ch.match(/[A-Z]/))ch='#';
        letters[ch]=true;
    });
    Object.keys(letters).sort().forEach(function(l){
        var btn=document.createElement('button');
        btn.textContent=l;
        btn.onclick=function(){
            valorantFuncLetter=valorantFuncLetter===l?'':l;
            valorantFuncPage=1;
            c.querySelectorAll('button').forEach(function(b){b.classList.remove('active')});
            if(valorantFuncLetter)btn.classList.add('active');
            renderValorantFunctions();
        };
        c.appendChild(btn);
    });
}

// ===== VALORANT OBJECTS =====
var valorantObjPage=1,valorantObjPageSize=500,valorantObjFiltered=null;
function filterValorantObjects(){
    var q=document.getElementById('valorant-obj-search').value.toLowerCase();
    var t=document.getElementById('valorant-obj-type').value;
    valorantObjFiltered=valorantObjData;
    if(t)valorantObjFiltered=valorantObjFiltered.filter(function(e){return e[2]===t});
    if(q)valorantObjFiltered=valorantObjFiltered.filter(function(e){
        return e[3].toLowerCase().indexOf(q)!==-1||e[2].toLowerCase().indexOf(q)!==-1||String(e[0]).indexOf(q)!==-1;
    });
    valorantObjPage=1;renderValorantObjects();
}
function renderValorantObjects(){
    if(!valorantObjFiltered)valorantObjFiltered=valorantObjData;
    var total=valorantObjFiltered.length,pages=Math.ceil(total/valorantObjPageSize);
    if(valorantObjPage>pages)valorantObjPage=pages||1;
    var s=(valorantObjPage-1)*valorantObjPageSize,e=Math.min(s+valorantObjPageSize,total),rows='';
    for(var i=s;i<e;i++){
        var n=valorantObjFiltered[i];
        rows+='<tr><td class="idx">'+n[0]+'</td><td class="type">'+esc(n[2])+'</td><td class="name">'+esc(n[3])+'</td></tr>';
    }
    document.getElementById('valorant-obj-tbody').innerHTML=rows;
    document.getElementById('valorant-obj-count').textContent='Showing '+(s+1)+'-'+e+' of '+total.toLocaleString()+' objects';
    renderPagination('valorant-obj-pagination',valorantObjPage,pages,function(p){valorantObjPage=p;renderValorantObjects()});
}

// ===== VALORANT SDK =====
var valorantSdkCat='Structs',valorantSdkFiltered=null,valorantSdkSelected='',valorantSdkItemH=32;
function switchValorantSDKCat(cat){
    valorantSdkCat=cat;
    valorantSdkSelected='';
    document.querySelectorAll('#valorant-sdk-tabs .sdk-tab').forEach(function(t){t.classList.toggle('active',t.getAttribute('data-cat')===cat)});
    document.getElementById('valorant-sdk-file-name').textContent='Select an item';
    document.getElementById('valorant-sdk-file-cat').textContent=cat.slice(0,-1);
    document.getElementById('valorant-sdk-file-content').innerHTML='<div style="padding:40px;text-align:center;color:var(--fg2);font-size:12px">Click an item on the left to view its content</div>';
    document.getElementById('valorant-sdk-search').value='';
    filterValorantSDK();
}
function initValorantSDKTabs(){
    var cats=['Structs','Classes','Enums'];
    cats.forEach(function(c){
        var el=document.getElementById('valorant-sdk-tab-count-'+c);
        if(el)el.textContent=' ('+((valorantSdkData[c]||[]).length)+')';
    });
}
function filterValorantSDK(){
    var q=document.getElementById('valorant-sdk-search').value.toLowerCase();
    var all=valorantSdkData[valorantSdkCat]||[];
    valorantSdkFiltered=q?all.filter(function(k){return k.toLowerCase().indexOf(q)!==-1}):all.slice();
    document.getElementById('valorant-sdk-count').textContent=valorantSdkFiltered.length+' items';
    valorantSdkRenderVirtual();
}
function valorantSdkRenderVirtual(){
    var container=document.getElementById('valorant-sdk-scroll-container');
    var list=document.getElementById('valorant-sdk-list');
    var spacer=document.getElementById('valorant-sdk-scroll-spacer');
    var total=valorantSdkFiltered?valorantSdkFiltered.length:0;
    spacer.style.height=(total*valorantSdkItemH)+'px';
    var scrollTop=container.scrollTop;
    var viewH=container.clientHeight;
    var start=Math.max(0,Math.floor(scrollTop/valorantSdkItemH)-10);
    var end=Math.min(total,Math.ceil((scrollTop+viewH)/valorantSdkItemH)+10);
    var html='';
    for(var i=start;i<end;i++){
        var name=valorantSdkFiltered[i];
        var key=valorantSdkCat+'/'+name;
        var cls=key===valorantSdkSelected?'sdk-file-item selected':'sdk-file-item';
        html+='<div class="'+cls+'" onclick="selectValorantSDK(\''+esc(name)+'\')">'+esc(name)+'</div>';
    }
    list.innerHTML=html;
    list.style.top=(start*valorantSdkItemH)+'px';
}
function selectValorantSDK(name){
    valorantSdkSelected=name;
    document.getElementById('valorant-sdk-file-name').textContent=name;
    document.getElementById('valorant-sdk-file-cat').textContent=valorantSdkCat.slice(0,-1);
    var content=valorantSdkContent[valorantSdkCat+'/'+name]||'// No content available';
    document.getElementById('valorant-sdk-file-content').innerHTML='<pre style="margin:0;padding:16px;font-size:12px;line-height:1.6;color:var(--fg);white-space:pre;overflow-x:auto">'+highlightSDK(content)+'</pre>';
    valorantSdkRenderVirtual();
}

// ===== VALORANT OFFSETS =====
function copyValorantOffsets(){
    var text='// Offsets.hpp (Valorant)\n#pragma once\n#include <cstdint>\n\nnamespace Offsets {\n\n';
    var els=document.querySelectorAll('#panel-valorant-offsets .offset-group');
    els.forEach(function(g){
        var ns=g.querySelector('.offset-ns').textContent.trim();
        text+='namespace '+ns+' {\n';
        g.querySelectorAll('.offset-entry').forEach(function(e){
            var name=e.querySelector('.offset-name').textContent.trim();
            var val=e.querySelector('.offset-val').childNodes[0].textContent.trim();
            var type=val.startsWith('0x')&&val.length<=10?'uint32_t':'uint64_t';
            if(ns==='Global')type='uint64_t';
            text+='    constexpr '+type+' '+name+' = '+val+';\n';
        });
        text+='}\n\n';
    });
    text+='}\n';
    navigator.clipboard.writeText(text).then(function(){
        var btn=document.querySelector('#panel-valorant-offsets button');
        btn.textContent='Copied!';
        btn.style.color='var(--accent)';
        setTimeout(function(){btn.textContent='Copy Offsets';btn.style.color='var(--fg)';},2000);
    });
}
function exportValorantOffsets(){
    var text='// Auto-generated by HWIDR SDK Dumper (Valorant)\n#pragma once\n#include <cstdint>\n\nnamespace Offsets {\n\n';
    var els=document.querySelectorAll('#panel-valorant-offsets .offset-group');
    els.forEach(function(g){
        var ns=g.querySelector('.offset-ns').textContent.trim();
        text+='namespace '+ns+' {\n';
        g.querySelectorAll('.offset-entry').forEach(function(e){
            var name=e.querySelector('.offset-name').textContent.trim();
            var val=e.querySelector('.offset-val').childNodes[0].textContent.trim();
            var type=val.startsWith('0x')&&val.length<=10?'uint32_t':'uint64_t';
            if(ns==='Global')type='uint64_t';
            text+='    constexpr '+type+' '+name+' = '+val+';\n';
        });
        text+='}\n\n';
    });
    text+='}\n';
    var blob=new Blob([text],{type:'text/plain'});
    var a=document.createElement('a');
    a.href=URL.createObjectURL(blob);
    a.download='Offsets_Valorant.hpp';
    a.click();
    URL.revokeObjectURL(a.href);
}

// ===== VALORANT EXPORTS =====
function exportValorantNames(){
    var text='// NameDump_Valorant.txt\n';
    valorantNameData.forEach(function(e){text+='['+e[0]+'] '+e[1]+'\n';});
    downloadText('NameDump_Valorant.txt', text);
}
function exportValorantFunctions(){
    var text='// FunctionsDump_Valorant.txt\n';
    var keys=Object.keys(valorantFuncData).sort();
    keys.forEach(function(cls){
        text+='['+cls+']\n';
        valorantFuncData[cls].forEach(function(f){text+=f[0]+' flags='+f[1]+'\n';});
    });
    downloadText('FunctionsDump_Valorant.txt', text);
}
function exportValorantObjects(){
    var text='// ObjectDump_Valorant.txt\n';
    valorantObjData.forEach(function(e){text+='['+e[0]+'] '+e[1]+' '+e[2]+' '+e[3]+'\n';});
    downloadText('ObjectDump_Valorant.txt', text);
}

// ===== CAPTCHA =====
function onCaptchaSuccess(){
    var ov=document.getElementById('captcha-overlay');
    ov.classList.add('hidden');
    setTimeout(function(){ov.style.display='none'},500);
}

// ===== INIT =====
initFuncLetters();
initSDKTabs();
filterSDK();
renderDocsEndpoints();
document.getElementById('sdk-scroll-container').addEventListener('scroll',function(){sdkRenderVirtual()});
document.getElementById('valorant-sdk-scroll-container').addEventListener('scroll',function(){valorantSdkRenderVirtual()});
filterNames();
filterFunctions();
filterObjects();
if(apexData){
    filterApexRT();
    document.getElementById('apex-rt-scroll-container').addEventListener('scroll',function(){apexRTRenderVirtual()});
}
fetchBuildStatus('fortnite');
fetchBuildStatus('apex_legends');
fetchBuildStatus('valorant');
checkStatus();


;
</script>
</body>
</html>
